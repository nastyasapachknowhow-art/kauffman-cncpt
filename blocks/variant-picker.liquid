{% liquid
  assign product_resource = closest.product

  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign selected_variant = product_resource.selected_or_first_available_variant

  assign selected_variant_stock_state = 'out_of_stock'
  if selected_variant.available
    assign selected_variant_stock_state = 'in_stock'

    if selected_variant.inventory_quantity > 0 and selected_variant.inventory_quantity <= 5
      assign selected_variant_stock_state = 'few_left'
    endif
  endif
-%}

{% unless product_resource == blank %}
  <style>
    .kauffman-stock-status-wrapper {
      margin-block-end: 16px;
      text-align: {{ block.settings.alignment | default: 'left' }};
    }

    .kauffman-stock-status {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #8f8a84;
      font-size: {{ block.settings.kauffman_stock_status_font_size_desktop | default: 14 }}px;
      line-height: 1.25;
      font-weight: {{ block.settings.kauffman_stock_status_font_weight | default: 300 }};
    }

    .kauffman-stock-status__dot {
      width: {{ block.settings.kauffman_stock_status_dot_size | default: 8 }}px;
      height: {{ block.settings.kauffman_stock_status_dot_size | default: 8 }}px;
      flex: 0 0 {{ block.settings.kauffman_stock_status_dot_size | default: 8 }}px;
      border-radius: 999px;
      display: inline-block;
    }

    .kauffman-stock-status--in-stock .kauffman-stock-status__dot {
      background-color: #27843a;
    }

    .kauffman-stock-status--few-left .kauffman-stock-status__dot {
      background-color: #d6a500;
    }

    .kauffman-stock-status--out-of-stock .kauffman-stock-status__dot {
      background-color: #b7352d;
    }

    .kauffman-stock-status__subtext,
    .kauffman-stock-status__notify {
      display: block;
      margin-block-start: 2px;
      color: #8f8a84;
      font-size: {{ block.settings.kauffman_stock_status_font_size_desktop | default: 14 }}px;
      line-height: 1.25;
      font-weight: {{ block.settings.kauffman_stock_status_font_weight | default: 300 }};
      text-align: left;
    }

    .kauffman-stock-status__notify {
      width: fit-content;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    @media screen and (max-width: 820px) {
      .kauffman-stock-status,
      .kauffman-stock-status__subtext,
      .kauffman-stock-status__notify {
        font-size: {{ block.settings.kauffman_stock_status_font_size_mobile | default: 14 }}px;
      }
    }

    /* Kauffman swatch selector refinement */
    .variant-picker .variant-option--swatches,
    .variant-picker .variant-option:has(.swatch),
    variant-picker .variant-option--swatches,
    variant-picker .variant-option:has(.swatch) {
      --kauffman-swatch-gap: {{ block.settings.kauffman_font_swatches_gap | default: 8 }}px;
    }

    .variant-picker .variant-option--swatches .variant-option__swatches,
    .variant-picker .variant-option:has(.swatch) .variant-option__swatches,
    .variant-picker .variant-option--swatches .variant-option__values,
    .variant-picker .variant-option:has(.swatch) .variant-option__values,
    variant-picker .variant-option--swatches .variant-option__swatches,
    variant-picker .variant-option:has(.swatch) .variant-option__swatches,
    variant-picker .variant-option--swatches .variant-option__values,
    variant-picker .variant-option:has(.swatch) .variant-option__values {
      gap: var(--kauffman-swatch-gap);
      column-gap: var(--kauffman-swatch-gap);
      row-gap: var(--kauffman-swatch-gap);
    }

    .variant-picker .swatch-input__label,
    .variant-picker label:has(.swatch),
    variant-picker .swatch-input__label,
    variant-picker label:has(.swatch) {
      padding: 2px;
      border: 1px solid transparent;
      border-radius: 999px;
      box-shadow: none;
      outline: none;
    }

    .variant-picker .swatch-input__input:checked + .swatch-input__label,
    .variant-picker input[type='radio']:checked + .swatch-input__label,
    .variant-picker label:has(input[type='radio']:checked),
    variant-picker .swatch-input__input:checked + .swatch-input__label,
    variant-picker input[type='radio']:checked + .swatch-input__label,
    variant-picker label:has(input[type='radio']:checked) {
      border-color: currentColor;
      box-shadow: none;
      outline: none;
    }

    .variant-picker .swatch-input__input:checked + .swatch-input__label::before,
    .variant-picker .swatch-input__input:checked + .swatch-input__label::after,
    .variant-picker input[type='radio']:checked + .swatch-input__label::before,
    .variant-picker input[type='radio']:checked + .swatch-input__label::after,
    variant-picker .swatch-input__input:checked + .swatch-input__label::before,
    variant-picker .swatch-input__input:checked + .swatch-input__label::after,
    variant-picker input[type='radio']:checked + .swatch-input__label::before,
    variant-picker input[type='radio']:checked + .swatch-input__label::after {
      box-shadow: none;
      outline: none;
    }

    .variant-picker .swatch,
    variant-picker .swatch {
      box-shadow: none;
      outline: none;
    }

  </style>

  <div
    class="kauffman-stock-status-wrapper"
    data-kauffman-stock-status
    data-product-id="{{ product_resource.id }}"
  >
    <div
      class="kauffman-stock-status
        {% if selected_variant_stock_state == 'in_stock' %}
          kauffman-stock-status--in-stock
        {% elsif selected_variant_stock_state == 'few_left' %}
          kauffman-stock-status--few-left
        {% else %}
          kauffman-stock-status--out-of-stock
        {% endif %}"
      data-kauffman-stock-status-line
    >
      <span class="kauffman-stock-status__dot" aria-hidden="true"></span>
      <span data-kauffman-stock-status-text>
        {% if selected_variant_stock_state == 'in_stock' %}
          In Stock
        {% elsif selected_variant_stock_state == 'few_left' %}
          A few items left
        {% else %}
          Out of stock
        {% endif %}
      </span>
    </div>

    <div
      class="kauffman-stock-status__subtext"
      data-kauffman-stock-status-subtext
      {% unless selected_variant.available %}hidden style="display: none;"{% endunless %}
    >
      Gift-ready premium packaging
    </div>

    <a
      class="kauffman-stock-status__notify"
      href="#StickyNotifyPanel-{{ section.id }}"
      aria-controls="StickyNotifyPanel-{{ section.id }}"
      data-kauffman-stock-status-notify
      {% if selected_variant.available %}hidden style="display: none;"{% endif %}
    >
      {{ section.settings.sticky_notify_button_label | default: 'Notify me' }}
    </a>

    <script type="application/json" data-kauffman-stock-status-variants>
      [
        {%- for variant in product_resource.variants -%}
          {%- liquid
            assign variant_stock_state = 'out_of_stock'
            if variant.available
              assign variant_stock_state = 'in_stock'

              if variant.inventory_quantity > 0 and variant.inventory_quantity <= 5
                assign variant_stock_state = 'few_left'
              endif
            endif
          -%}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "stock_state": {{ variant_stock_state | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </div>

  {% render 'variant-main-picker', product_resource: product_resource, block: block, section: section, product: product %}


  <script>
    (() => {
      if (window.KauffmanStockStatusLoaded) return;
      window.KauffmanStockStatusLoaded = true;

      const getVariantFromUrl = (variants) => {
        const variantId = new URLSearchParams(window.location.search).get('variant');
        if (!variantId) return null;

        return variants.find((variant) => String(variant.id) === String(variantId)) || null;
      };

      const getSelectedOptions = (container) => {
        const optionInputs = Array.from(
          container.querySelectorAll(
            'input[type="radio"]:checked, select[name^="options"], select[name^="option"], select[data-kauffman-native-select]'
          )
        );

        const groupedOptions = [];

        optionInputs.forEach((input) => {
          if (input.tagName === 'SELECT') {
            groupedOptions.push(input.value);
            return;
          }

          const name = input.getAttribute('name') || '';
          const existingIndex = groupedOptions.findIndex((item) => item && item.name === name);

          if (existingIndex === -1) {
            groupedOptions.push({ name, value: input.value });
          } else {
            groupedOptions[existingIndex] = { name, value: input.value };
          }
        });

        return groupedOptions.map((option) => (typeof option === 'string' ? option : option.value)).filter(Boolean);
      };

      const getVariantFromSelectedOptions = (variants, selectedOptions) => {
        if (!selectedOptions.length) return null;

        return variants.find((variant) => {
          if (!variant.options || variant.options.length !== selectedOptions.length) return false;

          return variant.options.every((option, index) => String(option) === String(selectedOptions[index]));
        }) || null;
      };

      const getStockState = (variant) => {
        if (variant?.stock_state) return variant.stock_state;
        if (!variant?.available) return 'out_of_stock';

        const quantity = Number(variant.inventory_quantity);
        const hasLowStock = Number.isFinite(quantity) && quantity > 0 && quantity <= 5;

        return hasLowStock ? 'few_left' : 'in_stock';
      };

      const updateStockStatus = (wrapper, variant) => {
        if (!variant) return;

        const statusLine = wrapper.querySelector('[data-kauffman-stock-status-line]');
        const statusText = wrapper.querySelector('[data-kauffman-stock-status-text]');
        const subtext = wrapper.querySelector('[data-kauffman-stock-status-subtext]');
        const notify = wrapper.querySelector('[data-kauffman-stock-status-notify]');

        if (!statusLine || !statusText) return;

        statusLine.classList.remove(
          'kauffman-stock-status--in-stock',
          'kauffman-stock-status--few-left',
          'kauffman-stock-status--out-of-stock'
        );

        const stockState = getStockState(variant);

        if (stockState === 'in_stock') {
          statusLine.classList.add('kauffman-stock-status--in-stock');
          statusText.textContent = 'In Stock';

          if (subtext) {
            subtext.hidden = false;
            subtext.style.display = '';
          }
          if (notify) {
            notify.hidden = true;
            notify.style.display = 'none';
          }
        } else if (stockState === 'few_left') {
          statusLine.classList.add('kauffman-stock-status--few-left');
          statusText.textContent = 'A few items left';

          if (subtext) {
            subtext.hidden = false;
            subtext.style.display = '';
          }
          if (notify) {
            notify.hidden = true;
            notify.style.display = 'none';
          }
        } else {
          statusLine.classList.add('kauffman-stock-status--out-of-stock');
          statusText.textContent = 'Out of stock';

          if (subtext) {
            subtext.hidden = true;
            subtext.style.display = 'none';
          }
          if (notify) {
            notify.hidden = false;
            notify.style.display = '';
          }
        }
      };

      const getPickerForWrapper = (wrapper) => {
        const productSection = wrapper.closest('.shopify-section') || document;
        const productId = wrapper.dataset.productId;

        if (productId) {
          return productSection.querySelector(`variant-picker[data-product-id="${CSS.escape(productId)}"]`);
        }

        return productSection.querySelector('variant-picker');
      };

      const refreshWrapper = (wrapper, preferredVariant = null) => {
        const variantsScript = wrapper.querySelector('[data-kauffman-stock-status-variants]');
        if (!variantsScript) return;

        let variants = [];

        try {
          variants = JSON.parse(variantsScript.textContent);
        } catch (error) {
          return;
        }

        const picker = getPickerForWrapper(wrapper);
        const preferredVariantFromMetadata = preferredVariant?.id
          ? variants.find((item) => String(item.id) === String(preferredVariant.id))
          : null;
        const variant =
          preferredVariantFromMetadata ||
          getVariantFromSelectedOptions(variants, picker ? getSelectedOptions(picker) : []) ||
          getVariantFromUrl(variants) ||
          variants.find((item) => item.available) ||
          variants[0];

        updateStockStatus(wrapper, variant);
      };

      const refreshAll = () => {
        document.querySelectorAll('[data-kauffman-stock-status]').forEach(refreshWrapper);
      };

      const refreshFromVariantEvent = (event) => {
        const variant = event.detail?.resource;
        const productId = event.detail?.data?.productId;

        if (!variant || !productId) {
          refreshAll();
          return;
        }

        document.querySelectorAll('[data-kauffman-stock-status]').forEach((wrapper) => {
          if (String(wrapper.dataset.productId) === String(productId)) {
            refreshWrapper(wrapper, variant);
          }
        });
      };

      const handleNotifyClick = (event) => {
        if (!(event.target instanceof Element)) return;

        const trigger = event.target.closest('[data-kauffman-stock-status-notify]');
        if (!trigger) return;

        const wrapper = trigger.closest('[data-kauffman-stock-status]');
        const productId = wrapper?.dataset.productId;
        const stickyTarget = productId
          ? document.querySelector(`sticky-add-to-cart[data-product-id="${CSS.escape(productId)}"]`)
          : document.querySelector('sticky-add-to-cart');

        if (!stickyTarget) return;

        event.preventDefault();
        trigger.dispatchEvent(
          new CustomEvent('kauffman:open-notify-me', {
            bubbles: true,
            detail: { productId },
          })
        );
      };

      document.addEventListener('change', refreshAll);
      document.addEventListener('input', refreshAll);
      document.addEventListener('click', handleNotifyClick);
      document.addEventListener('variant:selected', refreshAll);
      document.addEventListener('variant:update', refreshFromVariantEvent);

      const originalPushState = history.pushState;
      const originalReplaceState = history.replaceState;

      history.pushState = function () {
        originalPushState.apply(this, arguments);
        window.dispatchEvent(new Event('kauffman:url-change'));
      };

      history.replaceState = function () {
        originalReplaceState.apply(this, arguments);
        window.dispatchEvent(new Event('kauffman:url-change'));
      };

      window.addEventListener('popstate', refreshAll);
      window.addEventListener('kauffman:url-change', refreshAll);

      refreshAll();
    })();
  </script>
{% endunless %}

