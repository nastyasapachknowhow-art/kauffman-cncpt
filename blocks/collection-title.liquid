{%- liquid
  assign collection_label = ''
  assign collection_url = ''

  if closest.product != blank
    assign collection_label = closest.product.metafields.custom.collection.value | strip

    if collection_label != blank
      assign collection_label_key = collection_label | downcase
      assign collection_handle = collection_label | handleize
      assign target_collection = blank

      for product_collection in closest.product.collections
        assign product_collection_title_key = product_collection.title | strip | downcase

        if product_collection_title_key == collection_label_key or product_collection.handle == collection_handle
          assign target_collection = product_collection
          break
        endif
      endfor

      if target_collection == blank and collection_handle != blank
        assign target_collection = collections[collection_handle]
      endif

      if target_collection != blank and target_collection.url != blank
        assign collection_url = target_collection.url
      endif
    endif
  endif

  if collection_label == blank and closest.collection != blank
    assign collection_label = closest.collection.title
  endif

  if collection_label == blank
    assign collection_label = 'placeholders.collection_title' | t
  endif
-%}

{%- capture collection_title -%}
  <p>
    {%- if collection_url != blank -%}
      <a class="collection-title__link" href="{{ collection_url | escape }}">
        {{- collection_label | escape -}}
      </a>
    {%- else -%}
      {{- collection_label | escape -}}
    {%- endif -%}
  </p>
{%- endcapture -%}

{% render 'text', fallback_text: collection_title, block: block %}

{% stylesheet %}
  .collection-title__link {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .collection-title__link:hover,
  .collection-title__link:focus-visible {
    text-decoration: underline;
  }

  .collection-title__link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 3px;
  }
{% endstylesheet %}

