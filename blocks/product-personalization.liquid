{% liquid
  assign product_resource = closest.product
  assign block_settings = block.settings
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id

  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign personalization_type_raw = ''

  if product_resource != blank
    assign personalization_type_raw = product_resource.metafields.custom.personalization_type.value | default: '' | strip
  endif

  assign personalization_type = personalization_type_raw | handleize
  assign gender_options = block_settings.gender_options | default: 'Female, Male, Other' | split: ','
  assign clothing_size_options = block_settings.clothing_size_options | default: 'XS, S, M, L, XL, XXL' | split: ','
  assign month_options = 'January,February,March,April,May,June,July,August,September,October,November,December' | split: ','
-%}

{% unless product_resource == blank %}
  <style>

    .kauffman-personalization {
      width: 100%;
      max-width: var(--kauffman-personalization-width-desktop);
      margin: 0 0 24px;
    }

    .kauffman-personalization--center {
      margin-inline: auto;
    }

    .kauffman-personalization--right {
      margin-left: auto;
    }

    @media screen and (max-width: 820px) {
      .kauffman-personalization {
        max-width: var(--kauffman-personalization-width-mobile);
      }
    }

    .kauffman-personalization__label {
      display: block;
      margin: 0 0 17px;
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 500;
      font-size: 14px;
      line-height: 18px;
      color: #111111;
    }

    .kauffman-personalization__fields {
      display: grid;
      gap: 14px;
    }

    .kauffman-personalization__row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .kauffman-personalization__field {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    .kauffman-personalization__field-label {
      display: block;
      margin: 0;
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 500;
      font-size: 12px;
      line-height: 16px;
      color: #111111;
    }

    .kauffman-personalization__input {
      box-sizing: border-box;
      width: 100%;
      height: 54px;
      margin: 0;
      padding: 0 18px;
      background: #F7F5F1;
      border: 1px solid #E5E0D8;
      border-radius: 0;
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 14px;
      line-height: 18px;
      color: #111111;
      letter-spacing: 0.08em;
      box-shadow: none;
      outline: none;
      appearance: none;
    }

    .kauffman-personalization__input::placeholder {
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 14px;
      line-height: 18px;
      color: #8A8680;
      letter-spacing: 0.08em;
      opacity: 1;
    }

    .kauffman-personalization__native-select {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .kauffman-personalization-select {
      position: relative;
      width: 100%;
      text-align: left;
    }

    .kauffman-personalization-select__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 54px;
      padding: 0 18px;
      border: 1px solid #E5E0D8;
      border-radius: 0;
      background: #F7F5F1;
      color: #111111;
      list-style: none;
      cursor: pointer;
    }

    .kauffman-personalization-select__summary::-webkit-details-marker {
      display: none;
    }

    .kauffman-personalization-select__summary:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }

    .kauffman-personalization-select__summary-text {
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 14px;
      line-height: 1.2;
      color: rgb(var(--color-foreground-rgb) / 0.5);
      letter-spacing: 0.08em;
    }

    .kauffman-personalization-select__caret {
      width: 10px;
      height: 10px;
      flex: 0 0 auto;
      margin-left: 16px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-3px);
      transition: transform 160ms ease;
    }

    .kauffman-personalization-select[open] .kauffman-personalization-select__caret {
      transform: rotate(225deg) translateY(-3px);
    }

    .kauffman-personalization-select__list {
      position: absolute;
      z-index: 20;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      max-height: 320px;
      overflow-y: auto;
      border: 1px solid #E5E0D8;
      border-radius: 0;
      background: #F7F5F1;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.08);
    }

    .kauffman-personalization-select__option {
      display: block;
      width: 100%;
      min-height: 48px;
      padding: 0 18px;
      border: 0;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
      background: transparent;
      color: #111111;
      font: inherit;
      font-size: 14px;
      line-height: 1.2;
      text-align: left;
      cursor: pointer;
    }

    .kauffman-personalization-select__option:last-child {
      border-bottom: 0;
    }

    .kauffman-personalization-select__option:hover,
    .kauffman-personalization-select__option:focus-visible,
    .kauffman-personalization-select__option.is-selected {
      background: rgb(var(--color-foreground-rgb) / 0.04);
    }

    .kauffman-personalization__input:focus {
      border-color: #111111;
      box-shadow: none;
      outline: none;
    }

    .kauffman-personalization__computed-value {
      margin: 0;
      font-family: Inter, sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 14px;
      line-height: 18px;
      color: rgb(var(--color-foreground-rgb) / 0.5);
      letter-spacing: 0.08em;
    }

    .kauffman-personalization__computed-value.is-empty {
      color: rgb(var(--color-foreground-rgb) / 0.5);
    }

    @media screen and (max-width: 820px) {
      .kauffman-personalization__row {
        grid-template-columns: 1fr;
      }

      .kauffman-personalization-select__summary {
        min-height: 52px;
        padding: 0 16px;
      }

      .kauffman-personalization-select__option {
        min-height: 48px;
        padding: 0 16px;
      }
    }
  </style>

  <div
    class="kauffman-personalization kauffman-personalization--{{ block_settings.alignment }}"
    style="
      --kauffman-personalization-width-desktop: {{ block_settings.input_width_desktop }}px;
      --kauffman-personalization-width-mobile: {{ block_settings.input_width_mobile }}px;
    "
  >
    {% if personalization_type == 'label-me' %}
      <p class="kauffman-personalization__label">Personalization</p>

      <div class="kauffman-personalization__fields">
        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-name">
            Name
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-name"
            class="kauffman-personalization__input"
            type="text"
            name="properties[Name]"
            form="{{ product_form_id }}"
            autocomplete="name"
            required
          >
        </div>

        <div class="kauffman-personalization__row">
          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-gender">
              Gender
            </label>
            <select
              id="kauffman-personalization-{{ section.id }}-gender"
              class="kauffman-personalization__native-select"
              name="properties[Gender]"
              form="{{ product_form_id }}"
              data-kauffman-personalization-native-select
              required
            >
              <option value="" selected disabled>Select</option>
              {% for gender_option in gender_options %}
                {% assign gender_label = gender_option | strip %}
                {% if gender_label != blank %}
                  <option value="{{ gender_label | escape }}">{{ gender_label }}</option>
                {% endif %}
              {% endfor %}
            </select>
            <details class="kauffman-personalization-select" data-kauffman-personalization-select>
              <summary class="kauffman-personalization-select__summary">
                <span class="kauffman-personalization-select__summary-text" data-kauffman-personalization-select-text>
                  Select
                </span>
                <span class="kauffman-personalization-select__caret" aria-hidden="true"></span>
              </summary>
              <div class="kauffman-personalization-select__list" role="listbox">
                {% for gender_option in gender_options %}
                  {% assign gender_label = gender_option | strip %}
                  {% if gender_label != blank %}
                    <button
                      type="button"
                      class="kauffman-personalization-select__option"
                      data-kauffman-personalization-option
                      data-target-select="kauffman-personalization-{{ section.id }}-gender"
                      data-value="{{ gender_label | escape }}"
                      role="option"
                      aria-selected="false"
                    >
                      {{ gender_label | escape }}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          </div>

          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-clothing-size">
              Clothing Size
            </label>
            <select
              id="kauffman-personalization-{{ section.id }}-clothing-size"
              class="kauffman-personalization__native-select"
              name="properties[Clothing Size]"
              form="{{ product_form_id }}"
              data-kauffman-personalization-native-select
              required
            >
              <option value="" selected disabled>Select</option>
              {% for clothing_size_option in clothing_size_options %}
                {% assign clothing_size_label = clothing_size_option | strip %}
                {% if clothing_size_label != blank %}
                  <option value="{{ clothing_size_label | escape }}">{{ clothing_size_label }}</option>
                {% endif %}
              {% endfor %}
            </select>
            <details class="kauffman-personalization-select" data-kauffman-personalization-select>
              <summary class="kauffman-personalization-select__summary">
                <span class="kauffman-personalization-select__summary-text" data-kauffman-personalization-select-text>
                  Select
                </span>
                <span class="kauffman-personalization-select__caret" aria-hidden="true"></span>
              </summary>
              <div class="kauffman-personalization-select__list" role="listbox">
                {% for clothing_size_option in clothing_size_options %}
                  {% assign clothing_size_label = clothing_size_option | strip %}
                  {% if clothing_size_label != blank %}
                    <button
                      type="button"
                      class="kauffman-personalization-select__option"
                      data-kauffman-personalization-option
                      data-target-select="kauffman-personalization-{{ section.id }}-clothing-size"
                      data-value="{{ clothing_size_label | escape }}"
                      role="option"
                      aria-selected="false"
                    >
                      {{ clothing_size_label | escape }}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          </div>
        </div>

        <div class="kauffman-personalization__row">
          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-country">
              Country
            </label>
            <input
              id="kauffman-personalization-{{ section.id }}-country"
              class="kauffman-personalization__input"
              type="text"
              name="properties[Country]"
              form="{{ product_form_id }}"
              autocomplete="country-name"
              required
            >
          </div>

          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-birth-year">
              Birth Year
            </label>
            <input
              id="kauffman-personalization-{{ section.id }}-birth-year"
              class="kauffman-personalization__input"
              type="number"
              name="properties[Birth Year]"
              form="{{ product_form_id }}"
              min="1930"
              max="9999"
              inputmode="numeric"
              required
            >
          </div>
        </div>

        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-special-symbols">
            Special Symbols
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-special-symbols"
            class="kauffman-personalization__input"
            type="text"
            name="properties[Special Symbols]"
            form="{{ product_form_id }}"
            placeholder="♡ ★ ✨"
            autocomplete="off"
          >
        </div>
      </div>
    {% elsif personalization_type == 'login' %}
      <p class="kauffman-personalization__label">Personalization</p>

      <div class="kauffman-personalization__fields">
        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-login-name">
            Name
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-login-name"
            class="kauffman-personalization__input"
            type="text"
            name="properties[Name]"
            form="{{ product_form_id }}"
            autocomplete="name"
            required
          >
        </div>
      </div>
    {% elsif personalization_type == 'morse-code' %}
      <p class="kauffman-personalization__label">Personalization</p>

      <div class="kauffman-personalization__fields">
        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-morse-name">
            Name
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-morse-name"
            class="kauffman-personalization__input"
            type="text"
            name="properties[Name]"
            form="{{ product_form_id }}"
            autocomplete="name"
            required
          >
        </div>

        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-morse-location">
            City / Location
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-morse-location"
            class="kauffman-personalization__input"
            type="text"
            name="properties[City / Location]"
            form="{{ product_form_id }}"
            autocomplete="address-level2"
            required
          >
        </div>
      </div>
    {% elsif personalization_type == 'save-the-date' %}
      <p class="kauffman-personalization__label">Personalization</p>

      <div class="kauffman-personalization__fields">
        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-date">
            Date
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-date"
            class="kauffman-personalization__input"
            type="date"
            name="properties[Date]"
            form="{{ product_form_id }}"
            required
          >
        </div>

        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-initials">
            Initials
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-initials"
            class="kauffman-personalization__input"
            type="text"
            name="properties[Initials]"
            form="{{ product_form_id }}"
            maxlength="6"
            autocomplete="off"
            required
          >
        </div>

        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-save-date-location">
            City / Location
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-save-date-location"
            class="kauffman-personalization__input"
            type="text"
            name="properties[City / Location]"
            form="{{ product_form_id }}"
            autocomplete="address-level2"
            required
          >
        </div>
      </div>
    {% elsif personalization_type == 'zodiac' %}
      <p class="kauffman-personalization__label">Personalization</p>

      <div class="kauffman-personalization__fields" data-kauffman-zodiac-group>
        <div class="kauffman-personalization__field">
          <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-first-initial">
            First Initial
          </label>
          <input
            id="kauffman-personalization-{{ section.id }}-first-initial"
            class="kauffman-personalization__input"
            type="text"
            name="properties[First Initial]"
            form="{{ product_form_id }}"
            maxlength="1"
            autocomplete="off"
            required
          >
        </div>

        <div class="kauffman-personalization__row">
          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-birth-month">
              Birth Date - Month
            </label>
            <select
              id="kauffman-personalization-{{ section.id }}-birth-month"
              class="kauffman-personalization__native-select"
              name="properties[Birth Date - Month]"
              form="{{ product_form_id }}"
              data-kauffman-personalization-native-select
              data-kauffman-zodiac-month
              required
            >
              <option value="" selected disabled>Select</option>
              {% for month_option in month_options %}
                <option value="{{ month_option | escape }}">{{ month_option }}</option>
              {% endfor %}
            </select>
            <details class="kauffman-personalization-select" data-kauffman-personalization-select>
              <summary class="kauffman-personalization-select__summary">
                <span class="kauffman-personalization-select__summary-text" data-kauffman-personalization-select-text>
                  Select
                </span>
                <span class="kauffman-personalization-select__caret" aria-hidden="true"></span>
              </summary>
              <div class="kauffman-personalization-select__list" role="listbox">
                {% for month_option in month_options %}
                  <button
                    type="button"
                    class="kauffman-personalization-select__option"
                    data-kauffman-personalization-option
                    data-target-select="kauffman-personalization-{{ section.id }}-birth-month"
                    data-value="{{ month_option | escape }}"
                    role="option"
                    aria-selected="false"
                  >
                    {{ month_option | escape }}
                  </button>
                {% endfor %}
              </div>
            </details>
          </div>

          <div class="kauffman-personalization__field">
            <label class="kauffman-personalization__field-label" for="kauffman-personalization-{{ section.id }}-birth-day">
              Birth Date - Day
            </label>
            <select
              id="kauffman-personalization-{{ section.id }}-birth-day"
              class="kauffman-personalization__native-select"
              name="properties[Birth Date - Day]"
              form="{{ product_form_id }}"
              data-kauffman-personalization-native-select
              data-kauffman-zodiac-day
              required
            >
              <option value="" selected disabled>Select</option>
              {% for birth_day in (1..31) %}
                <option value="{{ birth_day }}">{{ birth_day }}</option>
              {% endfor %}
            </select>
            <details class="kauffman-personalization-select" data-kauffman-personalization-select>
              <summary class="kauffman-personalization-select__summary">
                <span class="kauffman-personalization-select__summary-text" data-kauffman-personalization-select-text>
                  Select
                </span>
                <span class="kauffman-personalization-select__caret" aria-hidden="true"></span>
              </summary>
              <div class="kauffman-personalization-select__list" data-kauffman-zodiac-day-list role="listbox">
                {% for birth_day in (1..31) %}
                  <button
                    type="button"
                    class="kauffman-personalization-select__option"
                    data-kauffman-personalization-option
                    data-target-select="kauffman-personalization-{{ section.id }}-birth-day"
                    data-value="{{ birth_day }}"
                    role="option"
                    aria-selected="false"
                  >
                    {{ birth_day }}
                  </button>
                {% endfor %}
              </div>
            </details>
          </div>
        </div>

        <div class="kauffman-personalization__field">
          <span class="kauffman-personalization__field-label" id="kauffman-personalization-{{ section.id }}-zodiac-sign-label">
            Zodiac Sign
          </span>
          <p
            class="kauffman-personalization__computed-value is-empty"
            data-kauffman-zodiac-sign-text
            aria-live="polite"
          >
            Select birth date
          </p>
          <input
            id="kauffman-personalization-{{ section.id }}-zodiac-sign"
            type="hidden"
            name="properties[Zodiac Sign]"
            form="{{ product_form_id }}"
            data-kauffman-zodiac-sign
          >
        </div>
      </div>
    {% else %}
      <label class="kauffman-personalization__label" for="kauffman-personalization-{{ section.id }}">
        Personalization
      </label>

      <input
        id="kauffman-personalization-{{ section.id }}"
        class="kauffman-personalization__input"
        type="text"
        name="properties[Personalization]"
        form="{{ product_form_id }}"
        placeholder="CHRISTINA"
        autocomplete="off"
      >
    {% endif %}
  </div>

  <script>
    (() => {
      const selector = '[data-kauffman-personalization-native-select]';

      const getScopedSelect = (trigger) => {
        const selectId = trigger.dataset.targetSelect;
        const field = trigger.closest('.kauffman-personalization__field');

        if (field && selectId) {
          return field.querySelector(`#${CSS.escape(selectId)}`);
        }

        return selectId ? document.getElementById(selectId) : null;
      };

      const updateSelectUi = (select) => {
        if (!select) return;

        const field = select.closest('.kauffman-personalization__field');
        const customSelect = field?.querySelector('[data-kauffman-personalization-select]');
        const summaryText = customSelect?.querySelector('[data-kauffman-personalization-select-text]');
        const value = select.value;

        if (summaryText) {
          summaryText.textContent = value || 'Select';
        }

        customSelect?.querySelectorAll('[data-kauffman-personalization-option]').forEach((option) => {
          const isSelected = option.dataset.value === value;
          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        });
      };

      const monthDayLimits = {
        January: 31,
        February: 29,
        March: 31,
        April: 30,
        May: 31,
        June: 30,
        July: 31,
        August: 31,
        September: 30,
        October: 31,
        November: 30,
        December: 31,
      };

      const monthNumbers = {
        January: 1,
        February: 2,
        March: 3,
        April: 4,
        May: 5,
        June: 6,
        July: 7,
        August: 8,
        September: 9,
        October: 10,
        November: 11,
        December: 12,
      };

      const getZodiacSign = (month, day) => {
        const monthNumber = monthNumbers[month];
        const dayNumber = Number(day);

        if (!monthNumber || !dayNumber) return '';

        switch (monthNumber) {
          case 1:
            return dayNumber <= 19 ? 'Capricorn — ♑' : 'Aquarius — ♒';
          case 2:
            return dayNumber <= 18 ? 'Aquarius — ♒' : 'Pisces — ♓';
          case 3:
            return dayNumber <= 20 ? 'Pisces — ♓' : 'Aries — ♈';
          case 4:
            return dayNumber <= 19 ? 'Aries — ♈' : 'Taurus — ♉';
          case 5:
            return dayNumber <= 20 ? 'Taurus — ♉' : 'Gemini — ♊';
          case 6:
            return dayNumber <= 20 ? 'Gemini — ♊' : 'Cancer — ♋';
          case 7:
            return dayNumber <= 22 ? 'Cancer — ♋' : 'Leo — ♌';
          case 8:
            return dayNumber <= 22 ? 'Leo — ♌' : 'Virgo — ♍';
          case 9:
            return dayNumber <= 22 ? 'Virgo — ♍' : 'Libra — ♎';
          case 10:
            return dayNumber <= 22 ? 'Libra — ♎' : 'Scorpio — ♏';
          case 11:
            return dayNumber <= 21 ? 'Scorpio — ♏' : 'Sagittarius — ♐';
          case 12:
            return dayNumber <= 21 ? 'Sagittarius — ♐' : 'Capricorn — ♑';
          default:
            return '';
        }
      };

      const updateZodiacDayOptions = (group) => {
        const monthSelect = group.querySelector('[data-kauffman-zodiac-month]');
        const daySelect = group.querySelector('[data-kauffman-zodiac-day]');
        const dayList = group.querySelector('[data-kauffman-zodiac-day-list]');

        if (!monthSelect || !daySelect || !dayList) return;

        const currentDay = Number(daySelect.value);
        const maxDay = monthDayLimits[monthSelect.value] || 31;
        const nextDay = currentDay > 0 && currentDay <= maxDay ? String(currentDay) : '';

        daySelect.replaceChildren();

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Select';
        placeholder.disabled = true;
        placeholder.selected = true;
        daySelect.append(placeholder);

        dayList.replaceChildren();

        for (let day = 1; day <= maxDay; day += 1) {
          const value = String(day);
          const option = document.createElement('option');
          option.value = value;
          option.textContent = value;
          daySelect.append(option);

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'kauffman-personalization-select__option';
          button.dataset.kauffmanPersonalizationOption = '';
          button.dataset.targetSelect = daySelect.id;
          button.dataset.value = value;
          button.setAttribute('role', 'option');
          button.setAttribute('aria-selected', 'false');
          button.textContent = value;
          dayList.append(button);
        }

        daySelect.value = nextDay;
        updateSelectUi(daySelect);
      };

      const updateZodiacSign = (group) => {
        const monthSelect = group.querySelector('[data-kauffman-zodiac-month]');
        const daySelect = group.querySelector('[data-kauffman-zodiac-day]');
        const zodiacInput = group.querySelector('[data-kauffman-zodiac-sign]');
        const zodiacText = group.querySelector('[data-kauffman-zodiac-sign-text]');

        if (!monthSelect || !daySelect || !zodiacInput || !zodiacText) return;

        const zodiacValue = getZodiacSign(monthSelect.value, daySelect.value);
        zodiacInput.value = zodiacValue;
        zodiacText.textContent = zodiacValue || 'Select birth date';
        zodiacText.classList.toggle('is-empty', !zodiacValue);
        zodiacInput.dispatchEvent(new Event('change', { bubbles: true }));
      };

      if (!window.KauffmanPersonalizationSelectsLoaded) {
        window.KauffmanPersonalizationSelectsLoaded = true;

        document.addEventListener('click', (event) => {
          const summary = event.target.closest('[data-kauffman-personalization-select] > summary');

          if (!summary) return;

          const activeDetails = summary.closest('[data-kauffman-personalization-select]');

          requestAnimationFrame(() => {
            document.querySelectorAll('[data-kauffman-personalization-select][open]').forEach((details) => {
              if (details !== activeDetails) details.removeAttribute('open');
            });
          });
        });

        document.addEventListener('click', (event) => {
          const trigger = event.target.closest('[data-kauffman-personalization-option]');
          if (!trigger) return;

          const select = getScopedSelect(trigger);
          const customSelect = trigger.closest('[data-kauffman-personalization-select]');

          if (!select) return;

          select.value = trigger.dataset.value;
          updateSelectUi(select);
          customSelect?.removeAttribute('open');
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });

        document.addEventListener('click', (event) => {
          document.querySelectorAll('[data-kauffman-personalization-select][open]').forEach((details) => {
            if (!details.contains(event.target)) details.removeAttribute('open');
          });
        });

        document.addEventListener('change', (event) => {
          if (!event.target.matches(selector)) return;

          updateSelectUi(event.target);

          const zodiacGroup = event.target.closest('[data-kauffman-zodiac-group]');

          if (!zodiacGroup) return;

          if (event.target.matches('[data-kauffman-zodiac-month]')) {
            updateZodiacDayOptions(zodiacGroup);
          }

          if (
            event.target.matches('[data-kauffman-zodiac-month]') ||
            event.target.matches('[data-kauffman-zodiac-day]')
          ) {
            updateZodiacSign(zodiacGroup);
          }
        });
      }

      document.querySelectorAll(selector).forEach(updateSelectUi);
      document.querySelectorAll('[data-kauffman-zodiac-group]').forEach((group) => {
        updateZodiacDayOptions(group);
        updateZodiacSign(group);
      });
    })();
  </script>
{% endunless %}

