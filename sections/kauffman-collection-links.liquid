{% liquid
  assign section_id = 'KauffmanCollectionLinks-' | append: section.id
  assign text_font = section.settings.text_font
  assign text_font_italic = text_font | font_modify: 'style', 'italic'
%}

{% style %}
  {{ text_font | font_face: font_display: 'swap' }}
  {{ text_font_italic | font_face: font_display: 'swap' }}

  #{{ section_id }} {
    --kcl-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --kcl-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --kcl-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --kcl-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --kcl-content-width: {{ section.settings.content_width }}px;
    --kcl-min-height-desktop: {{ section.settings.min_height_desktop }}px;
    --kcl-min-height-mobile: {{ section.settings.min_height_mobile }}px;
    --kcl-font-family: '{{ text_font.family }}', {{ text_font.fallback_families }};
    --kcl-font-size-desktop: {{ section.settings.font_size_desktop }}px;
    --kcl-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --kcl-line-height: {{ section.settings.line_height | divided_by: 100.0 }};
    --kcl-letter-spacing-regular: {{ section.settings.regular_letter_spacing | divided_by: 100.0 }}em;
    --kcl-letter-spacing-hover: {{ section.settings.hover_letter_spacing | divided_by: 100.0 }}em;
    --kcl-hover-scale-x: {{ section.settings.hover_italic_scale_x | divided_by: 100.0 }};
    --kcl-text-color: {{ section.settings.text_color }};
    --kcl-active-text-color: {{ section.settings.active_text_color }};
    --kcl-image-width-desktop: {{ section.settings.image_width_desktop }}%;
    --kcl-image-width-mobile: {{ section.settings.image_width_mobile }}%;
    --kcl-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    --kcl-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --kcl-transition: {{ section.settings.transition_ms }}ms ease;
  }

  #{{ section_id }}.kcl-section {
    padding-top: var(--kcl-padding-top-desktop);
    padding-bottom: var(--kcl-padding-bottom-desktop);
    overflow: hidden;
  }

  #{{ section_id }} .kcl-section__inner {
    width: 100%;
    max-width: var(--kcl-content-width);
    margin-inline: auto;
    padding-inline: {{ section.settings.side_padding_desktop }}px;
  }

  #{{ section_id }} .kcl-stage {
    position: relative;
    min-height: var(--kcl-min-height-desktop);
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  #{{ section_id }} .kcl-images {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #{{ section_id }} .kcl-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--kcl-image-width-desktop);
    max-width: 760px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.985);
    transition: opacity var(--kcl-transition), transform var(--kcl-transition);
  }

  #{{ section_id }} .kcl-image.is-active {
    opacity: var(--kcl-image-opacity);
    transform: translate(-50%, -50%) scale(1);
  }

  #{{ section_id }} .kcl-image img,
  #{{ section_id }} .kcl-image svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #{{ section_id }} .kcl-image img {
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    object-fit: {{ section.settings.image_fit }};
  }

  #{{ section_id }} .kcl-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(var(--color-background, 255 255 255));
    opacity: var(--kcl-overlay-opacity);
    pointer-events: none;
  }

  #{{ section_id }} .kcl-list {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    align-items: baseline;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  #{{ section_id }} .kcl-item {
    display: inline-flex;
    align-items: baseline;
  }

  #{{ section_id }} .kcl-link {
    position: relative;
    display: inline-block;
    color: var(--kcl-text-color);
    font-family: var(--kcl-font-family);
    font-size: var(--kcl-font-size-desktop);
    font-weight: {{ section.settings.font_weight }};
    line-height: var(--kcl-line-height);
    text-decoration: none;
    text-transform: {{ section.settings.text_transform }};
    cursor: pointer;
    transition: color var(--kcl-transition);
  }

  #{{ section_id }} .kcl-text-layer {
    display: block;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity var(--kcl-transition), transform var(--kcl-transition), color var(--kcl-transition);
  }

  #{{ section_id }} .kcl-text-layer--regular {
    position: relative;
    z-index: 1;
    color: var(--kcl-text-color);
    font-style: {{ section.settings.font_style }};
    letter-spacing: var(--kcl-letter-spacing-regular);
    opacity: 1;
  }

  #{{ section_id }} .kcl-text-layer--hover {
    position: absolute;
    inset: 0;
    z-index: 2;
    color: var(--kcl-active-text-color);
    font-style: {{ section.settings.hover_font_style }};
    letter-spacing: var(--kcl-letter-spacing-hover);
    opacity: 0;
    transform: scaleX(var(--kcl-hover-scale-x));
    transform-origin: center center;
  }

  #{{ section_id }} .kcl-link:hover .kcl-text-layer--regular,
  #{{ section_id }} .kcl-link:focus-visible .kcl-text-layer--regular,
  #{{ section_id }} .kcl-link.is-active .kcl-text-layer--regular {
    opacity: 0;
  }

  #{{ section_id }} .kcl-link:hover .kcl-text-layer--hover,
  #{{ section_id }} .kcl-link:focus-visible .kcl-text-layer--hover,
  #{{ section_id }} .kcl-link.is-active .kcl-text-layer--hover {
    opacity: 1;
  }

  #{{ section_id }} .kcl-link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  #{{ section_id }} .kcl-line-break {
    flex-basis: 100%;
    width: 100%;
    height: 0;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }}.kcl-section {
      padding-top: var(--kcl-padding-top-mobile);
      padding-bottom: var(--kcl-padding-bottom-mobile);
    }

    #{{ section_id }} .kcl-section__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    #{{ section_id }} .kcl-stage {
      min-height: var(--kcl-min-height-mobile);
    }

    #{{ section_id }} .kcl-image {
      width: var(--kcl-image-width-mobile);
    }

    #{{ section_id }} .kcl-list {
      column-gap: {{ section.settings.column_gap_mobile }}px;
      row-gap: {{ section.settings.row_gap_mobile }}px;
    }

    #{{ section_id }} .kcl-link {
      font-size: var(--kcl-font-size-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .kcl-image,
    #{{ section_id }} .kcl-link,
    #{{ section_id }} .kcl-text-layer {
      transition: none;
    }
  }
{% endstyle %}

<section
  id="{{ section_id }}"
  class="kcl-section section color-{{ section.settings.color_scheme }}"
  data-kcl-root
  data-default-active="{% if section.settings.show_first_image %}0{% else %}-1{% endif %}"
>
  <div class="kcl-section__inner {{ section.settings.section_width }}">
    <div class="kcl-stage">
      <div class="kcl-images" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_collection = block.settings.collection
            assign item_image = block.settings.image
            if item_image == blank and item_collection != blank and item_collection.image != blank
              assign item_image = item_collection.image
            endif
            assign image_alt = block.settings.alt_text
            if image_alt == blank and item_image != blank
              assign image_alt = item_image.alt
            endif
            if image_alt == blank and item_collection != blank
              assign image_alt = item_collection.title
            endif
          -%}

          <div class="kcl-image{% if section.settings.show_first_image and forloop.first %} is-active{% endif %}" data-kcl-image="{{ forloop.index0 }}">
            {%- if item_image != blank -%}
              {{ item_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100, 1400', sizes: '(max-width: 749px) 80vw, 55vw', alt: image_alt }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="kcl-overlay"></div>

      <ul class="kcl-list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_collection = block.settings.collection
            assign item_title = block.settings.title | strip
            if item_title == blank and item_collection != blank
              assign item_title = item_collection.title
            endif
            if item_title == blank
              assign item_title = 'Collection'
            endif
            assign item_url = block.settings.custom_url
            if item_url == blank and item_collection != blank
              assign item_url = item_collection.url
            endif
            if item_url == blank
              assign item_url = '#'
            endif
          -%}

          <li class="kcl-item" {{ block.shopify_attributes }}>
            <a
              class="kcl-link{% if section.settings.show_first_image and forloop.first %} is-active{% endif %}"
              href="{{ item_url }}"
              data-kcl-link="{{ forloop.index0 }}"
            >
              {%- assign item_label = item_title | append: block.settings.trailing_text -%}
              <span class="kcl-text-layer kcl-text-layer--regular">{{ item_label | escape }}</span>
              <span class="kcl-text-layer kcl-text-layer--hover" aria-hidden="true">{{ item_label | escape }}</span>
            </a>
          </li>

          {%- if block.settings.line_break_after -%}
            <li class="kcl-line-break" aria-hidden="true"></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root || root.dataset.kclInitialized === 'true') return;

    root.dataset.kclInitialized = 'true';

    const links = [...root.querySelectorAll('[data-kcl-link]')];
    const images = [...root.querySelectorAll('[data-kcl-image]')];
    const defaultActive = Number(root.dataset.defaultActive || -1);

    const setActive = (index) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', Number(link.dataset.kclLink) === index);
      });

      images.forEach((image) => {
        image.classList.toggle('is-active', Number(image.dataset.kclImage) === index);
      });
    };

    links.forEach((link) => {
      const index = Number(link.dataset.kclLink);

      link.addEventListener('mouseenter', () => setActive(index));
      link.addEventListener('focus', () => setActive(index));
      link.addEventListener('touchstart', () => setActive(index), { passive: true });
    });

    root.addEventListener('mouseleave', () => {
      if (defaultActive >= 0) setActive(defaultActive);
    });
  })();
</script>

