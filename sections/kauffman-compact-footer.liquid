{% liquid
  assign footer_id = 'kauffman-compact-footer-' | append: section.id
  assign catalogue_menu = section.settings.catalogue_menu
  assign help_menu = section.settings.help_menu
  assign company_menu = section.settings.company_menu
  assign legal_menu = section.settings.legal_menu
  assign enabled_payment_types = section.settings.payment_icons | remove: ' ' | split: ','
  assign has_social_links = false
  for block in section.blocks
    if block.type == 'social_link' and block.settings.url != blank
      assign has_social_links = true
    endif
  endfor
  assign has_localization_tools = false
  if section.settings.show_language_selector and localization.available_languages.size > 1
    assign has_localization_tools = true
  endif
  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign has_localization_tools = true
  endif
%}


<footer id="{{ footer_id }}" class="kauffman-compact-footer color-scheme color-{{ section.settings.color_scheme }} color-scheme--{{ section.settings.color_scheme }}{% if section.settings.enable_monochrome_logos %} kcf--mono-logos{% endif %} kcf--logo-desktop-{{ section.settings.logo_alignment_desktop }} kcf--logo-mobile-{{ section.settings.logo_alignment_mobile }} kcf--brand-{{ section.settings.brand_text_alignment }} kcf--trust-{{ section.settings.trust_payment_alignment }} kcf--social-{{ section.settings.social_alignment }} kcf--utility-{{ section.settings.utility_alignment }}" style="--kcf-logo-width-desktop: {{ section.settings.logo_width_desktop }}px; --kcf-logo-width-mobile: {{ section.settings.logo_width_mobile }}px; --kcf-padding-top-desktop: {{ section.settings.padding_top_desktop }}px; --kcf-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px; --kcf-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --kcf-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --kcf-anpc-width: {{ section.settings.anpc_sal_width }}px; --kcf-odr-width: {{ section.settings.odr_width }}px; --kcf-mono-opacity: {{ section.settings.monochrome_opacity | divided_by: 100.0 }};">
  <div class="kcf__inner">
    <div class="kcf__brand-row">
      <div class="kcf__brand-lockup">
        <a class="kcf__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if section.settings.logo_svg_code != blank %}
            <span class="kcf__logo-svg" aria-hidden="true">{{ section.settings.logo_svg_code }}</span>
          {% elsif section.settings.footer_logo != blank %}
            {{ section.settings.footer_logo | image_url: width: 600 | image_tag: loading: 'lazy', class: 'kcf__logo-image', alt: section.settings.logo_alt }}
          {% else %}
            <span class="kcf__logo-text">{{ section.settings.logo_text }}</span>
          {% endif %}
        </a>
        {% if section.settings.logo_compact_text != blank %}
          <p class="kcf__logo-compact-text">{{ section.settings.logo_compact_text }}</p>
        {% endif %}
      </div>
    </div>

    <div class="kcf__desktop-grid">
      {% if section.settings.show_newsletter %}
        <section class="kcf__newsletter" aria-labelledby="kcf-newsletter-{{ section.id }}">
          {% if section.settings.newsletter_title != blank %}
            <h2 id="kcf-newsletter-{{ section.id }}" class="kcf__heading">{{ section.settings.newsletter_title }}</h2>
          {% endif %}
          {% if section.settings.newsletter_text != blank %}
            <div class="kcf__text">{{ section.settings.newsletter_text }}</div>
          {% endif %}

          {% form 'customer', class: 'kcf__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="KCFEmail-{{ section.id }}">{{ section.settings.email_placeholder }}</label>
            <input
              id="KCFEmail-{{ section.id }}"
              class="kcf__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder }}"
              autocomplete="email"
              required
            >
            <button class="kcf__button kcf__button--{{ section.settings.newsletter_button_style }}" type="submit">{{ section.settings.newsletter_button_label }}</button>
            {% if form.errors %}
              <div class="kcf__message" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
            {% if form.posted_successfully? %}
              <div class="kcf__message" role="status">{{ section.settings.success_message }}</div>
            {% endif %}
          {% endform %}
        </section>
      {% endif %}

      <nav class="kcf__desktop-nav" aria-label="Footer navigation">
        <div class="kcf__menu-column">
          <h2 class="kcf__heading">{{ section.settings.catalogue_heading }}</h2>
          <ul class="kcf__link-list" role="list">
            {% if catalogue_menu != blank %}
              {% for link in catalogue_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% else %}
              <li><a href="{{ routes.collections_url }}">All items</a></li>
              <li><a href="{{ routes.collections_url }}">New arrivals</a></li>
              <li><a href="{{ routes.collections_url }}">iPhone cases</a></li>
              <li><a href="{{ routes.collections_url }}">MacBook cases</a></li>
              <li><a href="{{ routes.collections_url }}">T-shirts</a></li>
              <li><a href="{{ routes.collections_url }}">Hoodies</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="kcf__menu-column">
          <h2 class="kcf__heading">{{ section.settings.help_heading }}</h2>
          <ul class="kcf__link-list" role="list">
            {% if help_menu != blank %}
              {% for link in help_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% else %}
              <li><a href="/pages/shipping-delivery">Shipping / Delivery</a></li>
              <li><a href="/pages/returns-exchanges">Return & Exchange</a></li>
              <li><a href="/pages/customer-support">Customer Support</a></li>
              <li><a href="/pages/faqs">FAQs</a></li>
              <li><a href="/pages/payment-methods">Payment Methods</a></li>
              <li><a href="/pages/care-guide">Care guide</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="kcf__menu-column">
          <h2 class="kcf__heading">{{ section.settings.company_heading }}</h2>
          <ul class="kcf__link-list" role="list">
            {% if company_menu != blank %}
              {% for link in company_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% else %}
              <li><a href="/pages/about-us">About us</a></li>
              <li><a href="/pages/contact">Contacts</a></li>
              <li><a href="/pages/care-guide">Care guide</a></li>
              <li><a href="/blogs/journal">Journal</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="kcf__menu-column">
          <h2 class="kcf__heading">{{ section.settings.legal_heading }}</h2>
          <ul class="kcf__link-list" role="list">
            {% if legal_menu != blank %}
              {% for link in legal_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% else %}
              <li><a href="/pages/terms-conditions">Terms & Conditions</a></li>
              <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
              <li><a href="/pages/cookie-policy">Cookie Policy</a></li>
              <li><a href="/pages/return-policy">Return Policy</a></li>
              <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
              <li><a href="/pages/warranty-guarantee">Warranty / Guarantee</a></li>
            {% endif %}
          </ul>
        </div>
      </nav>
    </div>

    <div class="kcf__mobile-layout">
      {% if section.settings.show_newsletter %}
        <section class="kcf__newsletter kcf__newsletter--mobile" aria-labelledby="kcf-newsletter-mobile-{{ section.id }}">
          {% if section.settings.newsletter_title != blank %}
            <h2 id="kcf-newsletter-mobile-{{ section.id }}" class="kcf__heading">{{ section.settings.newsletter_title }}</h2>
          {% endif %}
          {% if section.settings.newsletter_text != blank %}
            <div class="kcf__text">{{ section.settings.newsletter_text }}</div>
          {% endif %}

          {% form 'customer', class: 'kcf__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="KCFEmailMobile-{{ section.id }}">{{ section.settings.email_placeholder }}</label>
            <input
              id="KCFEmailMobile-{{ section.id }}"
              class="kcf__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder }}"
              autocomplete="email"
              required
            >
            <button class="kcf__button kcf__button--{{ section.settings.newsletter_button_style }}" type="submit">{{ section.settings.newsletter_button_label }}</button>
            {% if form.errors %}<div class="kcf__message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            {% if form.posted_successfully? %}<div class="kcf__message" role="status">{{ section.settings.success_message }}</div>{% endif %}
          {% endform %}
        </section>
      {% endif %}

      <nav class="kcf__mobile-nav" aria-label="Footer navigation">
        <details class="kcf__accordion">
          <summary class="kcf__summary">
            <span>{{ section.settings.shop_delivery_mobile_heading }}</span>
            <span class="kcf__plus" aria-hidden="true"></span>
          </summary>
          <div class="kcf__accordion-content">
            <div class="kcf__mobile-subcolumn">
              <h3 class="kcf__subheading">{{ section.settings.catalogue_heading }}</h3>
              <ul class="kcf__link-list" role="list">
                {% if catalogue_menu != blank %}
                  {% for link in catalogue_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
                {% else %}
                  <li><a href="{{ routes.collections_url }}">All items</a></li>
                  <li><a href="{{ routes.collections_url }}">New arrivals</a></li>
                  <li><a href="{{ routes.collections_url }}">iPhone cases</a></li>
                  <li><a href="{{ routes.collections_url }}">MacBook cases</a></li>
                  <li><a href="{{ routes.collections_url }}">T-shirts</a></li>
                  <li><a href="{{ routes.collections_url }}">Hoodies</a></li>
                {% endif %}
              </ul>
            </div>
            <div class="kcf__mobile-subcolumn">
              <h3 class="kcf__subheading">{{ section.settings.help_heading }}</h3>
              <ul class="kcf__link-list" role="list">
                {% if help_menu != blank %}
                  {% for link in help_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
                {% else %}
                  <li><a href="/pages/shipping-delivery">Shipping / Delivery</a></li>
                  <li><a href="/pages/returns-exchanges">Return & Exchange</a></li>
                  <li><a href="/pages/customer-support">Customer Support</a></li>
                  <li><a href="/pages/faqs">FAQs</a></li>
                  <li><a href="/pages/payment-methods">Payment Methods</a></li>
                {% endif %}
              </ul>
            </div>
          </div>
        </details>

        <details class="kcf__accordion">
          <summary class="kcf__summary">
            <span>{{ section.settings.legal_info_mobile_heading }}</span>
            <span class="kcf__plus" aria-hidden="true"></span>
          </summary>
          <div class="kcf__accordion-content">
            <div class="kcf__mobile-subcolumn">
              <h3 class="kcf__subheading">{{ section.settings.company_heading }}</h3>
              <ul class="kcf__link-list" role="list">
                {% if company_menu != blank %}
                  {% for link in company_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
                {% else %}
                  <li><a href="/pages/about-us">About us</a></li>
                  <li><a href="/pages/contact">Contacts</a></li>
                  <li><a href="/pages/care-guide">Care guide</a></li>
                  <li><a href="/blogs/journal">Journal</a></li>
                {% endif %}
              </ul>
            </div>
            <div class="kcf__mobile-subcolumn">
              <h3 class="kcf__subheading">{{ section.settings.legal_heading }}</h3>
              <ul class="kcf__link-list" role="list">
                {% if legal_menu != blank %}
                  {% for link in legal_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
                {% else %}
                  <li><a href="/pages/terms-conditions">Terms & Conditions</a></li>
                  <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
                  <li><a href="/pages/cookie-policy">Cookie Policy</a></li>
                  <li><a href="/pages/return-policy">Return Policy</a></li>
                  <li><a href="/pages/warranty-guarantee">Warranty / Guarantee</a></li>
                {% endif %}
              </ul>
            </div>
          </div>
        </details>
      </nav>
    </div>

    {% if has_localization_tools %}
      <div class="kcf__utility-row">
        {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
          <div class="kcf__language kcf__language--{{ section.settings.language_selector_style }}" aria-label="Language selector">
            {% form 'localization', class: 'kcf__language-form' %}
              {% if section.settings.language_selector_style == 'dropdown' %}
                {% capture current_language_flag %}
                  {% case localization.language.iso_code %}
                    {% when 'ro' %}🇷🇴
                    {% when 'en' %}🇬🇧
                    {% when 'de' %}🇩🇪
                    {% when 'fr' %}🇫🇷
                    {% when 'it' %}🇮🇹
                    {% when 'es' %}🇪🇸
                    {% when 'pt' %}🇵🇹
                    {% when 'nl' %}🇳🇱
                    {% when 'pl' %}🇵🇱
                    {% when 'bg' %}🇧🇬
                    {% when 'hu' %}🇭🇺
                    {% when 'cs' %}🇨🇿
                    {% when 'sk' %}🇸🇰
                    {% when 'sl' %}🇸🇮
                    {% when 'hr' %}🇭🇷
                    {% when 'el' %}🇬🇷
                    {% when 'sv' %}🇸🇪
                    {% when 'da' %}🇩🇰
                    {% when 'fi' %}🇫🇮
                    {% when 'et' %}🇪🇪
                    {% when 'lv' %}🇱🇻
                    {% when 'lt' %}🇱🇹
                    {% else %}🌐
                  {% endcase %}
                {% endcapture %}
                <details class="kcf__language-dropdown">
                  <summary class="kcf__language-summary">
                    {% if section.settings.show_language_flags %}<span class="kcf__language-flag" aria-hidden="true">{{ current_language_flag | strip }}</span>{% endif %}
                    <span class="kcf__language-current">{{ localization.language.iso_code | upcase }}</span>
                    <span class="kcf__language-chevron" aria-hidden="true">⌄</span>
                  </summary>
                  <div class="kcf__language-panel">
                    {% for language in localization.available_languages %}
                      {% capture language_flag %}
                        {% case language.iso_code %}
                          {% when 'ro' %}🇷🇴
                          {% when 'en' %}🇬🇧
                          {% when 'de' %}🇩🇪
                          {% when 'fr' %}🇫🇷
                          {% when 'it' %}🇮🇹
                          {% when 'es' %}🇪🇸
                          {% when 'pt' %}🇵🇹
                          {% when 'nl' %}🇳🇱
                          {% when 'pl' %}🇵🇱
                          {% when 'bg' %}🇧🇬
                          {% when 'hu' %}🇭🇺
                          {% when 'cs' %}🇨🇿
                          {% when 'sk' %}🇸🇰
                          {% when 'sl' %}🇸🇮
                          {% when 'hr' %}🇭🇷
                          {% when 'el' %}🇬🇷
                          {% when 'sv' %}🇸🇪
                          {% when 'da' %}🇩🇰
                          {% when 'fi' %}🇫🇮
                          {% when 'et' %}🇪🇪
                          {% when 'lv' %}🇱🇻
                          {% when 'lt' %}🇱🇹
                          {% else %}🌐
                        {% endcase %}
                      {% endcapture %}
                      <button
                        type="submit"
                        name="locale_code"
                        value="{{ language.iso_code }}"
                        class="kcf__language-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                        {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                      >
                        {% if section.settings.show_language_flags %}<span class="kcf__language-flag" aria-hidden="true">{{ language_flag | strip }}</span>{% endif %}
                        <span class="kcf__language-code">{{ language.iso_code | upcase }}</span>
                        <span class="kcf__language-name">{{ language.endonym_name | default: language.name }}</span>
                      </button>
                    {% endfor %}
                  </div>
                </details>
              {% else %}
                {% for language in localization.available_languages %}
                  {% capture language_flag %}
                    {% case language.iso_code %}
                      {% when 'ro' %}🇷🇴
                      {% when 'en' %}🇬🇧
                      {% when 'de' %}🇩🇪
                      {% when 'fr' %}🇫🇷
                      {% when 'it' %}🇮🇹
                      {% when 'es' %}🇪🇸
                      {% when 'pt' %}🇵🇹
                      {% when 'nl' %}🇳🇱
                      {% when 'pl' %}🇵🇱
                      {% when 'bg' %}🇧🇬
                      {% when 'hu' %}🇭🇺
                      {% when 'cs' %}🇨🇿
                      {% when 'sk' %}🇸🇰
                      {% when 'sl' %}🇸🇮
                      {% when 'hr' %}🇭🇷
                      {% when 'el' %}🇬🇷
                      {% when 'sv' %}🇸🇪
                      {% when 'da' %}🇩🇰
                      {% when 'fi' %}🇫🇮
                      {% when 'et' %}🇪🇪
                      {% when 'lv' %}🇱🇻
                      {% when 'lt' %}🇱🇹
                      {% else %}🌐
                    {% endcase %}
                  {% endcapture %}
                  <button
                    type="submit"
                    name="locale_code"
                    value="{{ language.iso_code }}"
                    class="kcf__language-button{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                    {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                  >
                    {% if section.settings.show_language_flags %}<span class="kcf__language-flag" aria-hidden="true">{{ language_flag | strip }}</span>{% endif %}
                    <span>{{ language.iso_code | upcase }}</span>
                  </button>
                {% endfor %}
              {% endif %}
            {% endform %}
          </div>
        {% endif %}

        {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
          <div class="kcf__country-wrap">
            {% form 'localization', class: 'kcf__country-form' %}
              <label class="visually-hidden" for="KCFCountry-{{ section.id }}">Country</label>
              <select id="KCFCountry-{{ section.id }}" class="kcf__country" name="country_code" onchange="this.form.submit()">
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.iso_code }})</option>
                {% endfor %}
              </select>
            {% endform %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="kcf__trust-payment-row">
      <div class="kcf__trust" aria-label="Trust badges">
        {% if section.settings.show_anpc_sal and section.settings.anpc_sal_logo != blank %}
          <a class="kcf__trust-item kcf__trust-item--anpc" href="{{ section.settings.anpc_sal_url | default: 'https://anpc.ro/ce-este-sal/' }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.anpc_sal_label | escape }}">
            {{ section.settings.anpc_sal_logo | image_url: width: 600 | image_tag: loading: 'lazy', class: 'kcf__trust-image kcf__trust-image--anpc kcf__mono-target', alt: section.settings.anpc_sal_label, style: '--badge-width: var(--kcf-anpc-width);' }}
          </a>
        {% endif %}

        {% if section.settings.show_odr and section.settings.odr_logo != blank %}
          <a class="kcf__trust-item kcf__trust-item--odr" href="{{ section.settings.odr_url | default: 'https://ec.europa.eu/consumers/odr' }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.odr_label | escape }}">
            {{ section.settings.odr_logo | image_url: width: 600 | image_tag: loading: 'lazy', class: 'kcf__trust-image kcf__trust-image--odr kcf__mono-target', alt: section.settings.odr_label, style: '--badge-width: var(--kcf-odr-width);' }}
          </a>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'trust_badge' %}
            {% if block.settings.url != blank %}<a href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{% else %}<span class="kcf__trust-static" {{ block.shopify_attributes }}>{% endif %}
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'kcf__trust-image kcf__mono-target', alt: block.settings.label, style: '--badge-width:' | append: block.settings.width | append: 'px;' }}
              {% else %}
                <span class="kcf__trust-text">{{ block.settings.label }}</span>
              {% endif %}
            {% if block.settings.url != blank %}</a>{% else %}</span>{% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.show_payment_icons %}
        <ul class="kcf__payments" role="list" aria-label="Payment methods">
          {% for type in enabled_payment_types %}
            {% if type != blank %}<li>{{ type | payment_type_svg_tag: class: 'kcf__payment-icon kcf__mono-target' }}</li>{% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>


    {% if has_social_links %}
      <div class="kcf__social-row" aria-label="Social links">
        {% if section.settings.social_label != blank %}
          <p class="kcf__social-label">{{ section.settings.social_label }}</p>
        {% endif %}
        <div class="kcf__socials">
          {% for block in section.blocks %}
            {% if block.type == 'social_link' and block.settings.url != blank %}
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
                {% if block.settings.custom_icon != blank %}
                  {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'kcf__social-icon', alt: block.settings.label }}
                {% else %}
                  <span>{{ block.settings.label | default: block.settings.social_type }}</span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="kcf__bottom-row">
      {% if section.settings.brand_text != blank %}
        <p class="kcf__brand-text">{{ section.settings.brand_text }}</p>
      {% endif %}

      <div class="kcf__copyright">
        <span>{{ section.settings.copyright_text }}</span>
        {% if legal_menu != blank %}
          <nav class="kcf__mini-legal" aria-label="Legal links">
            {% for link in legal_menu.links limit: 4 %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
          </nav>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

<style>
  .kauffman-compact-footer {
    --kcf-text: currentColor;
    --kcf-heading: currentColor;
    --kcf-muted: color-mix(in srgb, currentColor 68%, transparent);
    --kcf-border: color-mix(in srgb, currentColor 18%, transparent);
    --kcf-soft-border: color-mix(in srgb, currentColor 10%, transparent);
    font-family: Inter, var(--font-body--family), var(--font-body-family), sans-serif;
  }

  .kauffman-compact-footer *,
  .kauffman-compact-footer *::before,
  .kauffman-compact-footer *::after { box-sizing: border-box; }

  .kauffman-compact-footer a { color: inherit; text-decoration: none; }
  .kauffman-compact-footer h1,
  .kauffman-compact-footer h2,
  .kauffman-compact-footer h3,
  .kauffman-compact-footer p { font-family: inherit; }
  .kauffman-compact-footer ul { margin-block: 0; }

  .kcf__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: var(--kcf-padding-top-desktop, 48px) clamp(20px, 4vw, 64px) var(--kcf-padding-bottom-desktop, 24px);
  }

  .kcf__brand-row {
    display: flex;
    justify-content: center;
    margin-bottom: 34px;
  }

