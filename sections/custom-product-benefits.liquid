{% comment %}
  Custom Product Benefits
  File: sections/custom-product-benefits.liquid
{% endcomment %}

<section
  id="ProductBenefits-{{ section.id }}"
  class="product-benefits product-benefits--{{ section.id }}"
>
  <div class="product-benefits__inner">
    <div class="product-benefits__grid">
      {% for block in section.blocks %}
        <div class="product-benefits__item" {{ block.shopify_attributes }}>
          <div class="product-benefits__icon-wrap">
            {% if block.settings.icon != blank %}
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  class: 'product-benefits__icon product-benefits__icon--image',
                  loading: 'lazy',
                  alt: block.settings.label
              }}
            {% else %}
              <div class="product-benefits__icon product-benefits__icon--placeholder">
                {{ block.settings.fallback_icon }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.label != blank %}
            <div class="product-benefits__label">
              {{ block.settings.label }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .product-benefits--{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-benefits--{{ section.id }} .product-benefits__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  .product-benefits--{{ section.id }} .product-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    min-height: {{ section.settings.block_height }}px;
  }

  .product-benefits--{{ section.id }} .product-benefits__item {
    min-height: calc({{ section.settings.block_height }}px / 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.icon_label_gap }}px;
    text-align: center;
  }

  .product-benefits--{{ section.id }} .product-benefits__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
  }

  .product-benefits--{{ section.id }} .product-benefits__icon--image {
    display: block;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }

  .product-benefits--{{ section.id }} .product-benefits__icon--placeholder {
    font-family: Inter, sans-serif;
    font-size: {{ section.settings.fallback_icon_size }}px;
    line-height: 1;
    color: {{ section.settings.icon_color }};
  }

  .product-benefits--{{ section.id }} .product-benefits__label {
    max-width: {{ section.settings.label_max_width }}px;
    font-family: {{ section.settings.label_font_family }}, sans-serif;
    font-style: normal;
    font-weight: {{ section.settings.label_font_weight }};
    font-size: {{ section.settings.label_font_size }}px;
    line-height: {{ section.settings.label_line_height }}px;
    color: {{ section.settings.label_color }};
    text-align: center;
  }

  @media screen and (min-width: 821px) {
    .product-benefits--{{ section.id }} .product-benefits__grid {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      min-height: auto;
    }

    .product-benefits--{{ section.id }} .product-benefits__item {
      min-height: {{ section.settings.desktop_item_height }}px;
    }
  }

  @media screen and (max-width: 820px) {
    .product-benefits--{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .product-benefits--{{ section.id }} .product-benefits__inner {
      max-width: {{ section.settings.mobile_max_width }}px;
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    .product-benefits--{{ section.id }} .product-benefits__grid {
      min-height: {{ section.settings.mobile_block_height }}px;
    }

    .product-benefits--{{ section.id }} .product-benefits__item {
      min-height: calc({{ section.settings.mobile_block_height }}px / 2);
    }

    .product-benefits--{{ section.id }} .product-benefits__icon-wrap {
      width: {{ section.settings.mobile_icon_box_size }}px;
      height: {{ section.settings.mobile_icon_box_size }}px;
    }

    .product-benefits--{{ section.id }} .product-benefits__icon--image {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
    }

    .product-benefits--{{ section.id }} .product-benefits__label {
      max-width: {{ section.settings.mobile_label_max_width }}px;
      font-size: {{ section.settings.mobile_label_font_size }}px;
      line-height: {{ section.settings.mobile_label_line_height }}px;
    }
  }
</style>

