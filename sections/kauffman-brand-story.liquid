{% liquid
  assign section_id = 'KauffmanBrandStory-' | append: section.id
  assign section_anchor_id = section.settings.anchor_id | strip | handleize
  assign has_story_blocks = false

  for block in section.blocks
    if block.type == 'heading' or block.type == 'intro' or block.type == 'manifesto' or block.type == 'lifestyle' or block.type == 'closing'
      assign has_story_blocks = true
      break
    endif
  endfor
%}

{% if section_anchor_id != blank %}
  <span id="{{ section_anchor_id }}" class="kf-brand-story__anchor" aria-hidden="true"></span>
{% endif %}

<section
  id="{{ section_id }}"
  class="
    kf-brand-story
    kf-brand-story--layout-{{ section.settings.section_width }}
    {% if section.settings.show_top_border %}kf-brand-story--top-border{% endif %}
    {% if section.settings.show_bottom_border %}kf-brand-story--bottom-border{% endif %}
    {% if section.settings.enable_reveal %}kf-brand-story--reveal{% endif %}
  "
  style="background-color: #fff !important; background-image: none !important;"
>
  <div class="kf-brand-story__inner">
    {% if has_story_blocks %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <h2 class="kf-brand-story__section-heading" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %} {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {% endif %}

          {% when 'intro' %}
            <div class="kf-brand-story__intro" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %} {{ block.shopify_attributes }}>
              {% if block.settings.eyebrow != blank %}
                <p class="kf-brand-story__eyebrow">
                  {{ block.settings.eyebrow }}
                </p>
              {% endif %}

              {% if block.settings.headline_line_1 != blank or block.settings.headline_line_2 != blank or block.settings.headline_accent != blank %}
                <h2 class="kf-brand-story__headline">
                  {% if block.settings.headline_line_1 != blank %}
                    <span>{{ block.settings.headline_line_1 }}</span>
                  {% endif %}

                  {% if block.settings.headline_line_2 != blank %}
                    <span>{{ block.settings.headline_line_2 }}</span>
                  {% endif %}

                  {% if block.settings.headline_accent != blank %}
                    <span><em>{{ block.settings.headline_accent }}</em></span>
                  {% endif %}
                </h2>
              {% endif %}

              {% if block.settings.intro_text != blank %}
                <div class="kf-brand-story__intro-text rte">
                  {{ block.settings.intro_text }}
                </div>
              {% endif %}
            </div>

          {% when 'manifesto' %}
            <div class="kf-brand-story__manifesto" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %} {{ block.shopify_attributes }}>
              <div class="kf-brand-story__manifesto-lines">
                {% for line_block in section.blocks %}
                  {% if line_block.type == 'manifesto_line' %}
                    {% if line_block.settings.line_text != blank or line_block.settings.line_style == 'spacer' %}
                      {% if line_block.settings.line_style == 'spacer' %}
                        <span class="kf-brand-story__manifesto-line kf-brand-story__manifesto-line--spacer" {{ line_block.shopify_attributes }}></span>
                      {% else %}
                        <span
                          class="
                            kf-brand-story__manifesto-line
                            kf-brand-story__manifesto-line--{{ line_block.settings.line_style }}
                          "
                          {{ line_block.shopify_attributes }}
                        >
                          {{ line_block.settings.line_text }}
                        </span>
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>

          {% when 'lifestyle' %}
            {% if block.settings.text != blank %}
              <div class="kf-brand-story__lifestyle" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %} {{ block.shopify_attributes }}>
                <div class="kf-brand-story__lifestyle-text rte">
                  {{ block.settings.text }}
                </div>
              </div>
            {% endif %}

          {% when 'closing' %}
            <div class="kf-brand-story__closing" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %} {{ block.shopify_attributes }}>
              <div class="kf-brand-story__closing-copy">
                {% if block.settings.tag != blank %}
                  <p class="kf-brand-story__closing-tag">
                    {{ block.settings.tag }}
                  </p>
                {% endif %}

                {% if block.settings.line_1 != blank or block.settings.accent_1 != blank or block.settings.accent_2 != blank %}
                  <h3 class="kf-brand-story__closing-headline">
                    {% if block.settings.line_1 != blank %}
                      <span>{{ block.settings.line_1 }}</span>
                    {% endif %}

                    {% if block.settings.accent_1 != blank %}
                      <span><em>{{ block.settings.accent_1 }}</em></span>
                    {% endif %}

                    {% if block.settings.accent_2 != blank %}
                      <span class="kf-brand-story__closing-accent-2"><em>{{ block.settings.accent_2 }}</em></span>
                    {% endif %}
                  </h3>
                {% endif %}

                {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
                  <a class="kf-brand-story__cta" href="{{ block.settings.cta_link }}">
                    {{ block.settings.cta_label }}
                  </a>
                {% endif %}
              </div>

              {% if block.settings.show_mark and block.settings.mark != blank %}
                <div
                  class="
                    kf-brand-story__closing-mark
                    {% if block.settings.hide_mark_mobile %}kf-brand-story__closing-mark--hide-mobile{% endif %}
                  "
                  aria-hidden="true"
                >
                  {{ block.settings.mark }}
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    {% else %}
      {% if section.settings.section_heading != blank %}
        <h2 class="kf-brand-story__section-heading" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}>
          {{ section.settings.section_heading }}
        </h2>
      {% endif %}

      <div class="kf-brand-story__intro" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}>
        {% if section.settings.eyebrow != blank %}
          <p class="kf-brand-story__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.headline_line_1 != blank or section.settings.headline_line_2 != blank or section.settings.headline_accent != blank %}
          <h2 class="kf-brand-story__headline">
            {% if section.settings.headline_line_1 != blank %}
              <span>{{ section.settings.headline_line_1 }}</span>
            {% endif %}

            {% if section.settings.headline_line_2 != blank %}
              <span>{{ section.settings.headline_line_2 }}</span>
            {% endif %}

            {% if section.settings.headline_accent != blank %}
              <span><em>{{ section.settings.headline_accent }}</em></span>
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.intro_text != blank %}
          <div class="kf-brand-story__intro-text rte">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_manifesto %}
        <div class="kf-brand-story__manifesto" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}>
          <div class="kf-brand-story__manifesto-lines">
            {% for block in section.blocks %}
              {% if block.type == 'manifesto_line' %}
                {% if block.settings.line_text != blank or block.settings.line_style == 'spacer' %}
                  {% if block.settings.line_style == 'spacer' %}
                    <span class="kf-brand-story__manifesto-line kf-brand-story__manifesto-line--spacer" {{ block.shopify_attributes }}></span>
                  {% else %}
                    <span
                      class="
                        kf-brand-story__manifesto-line
                        kf-brand-story__manifesto-line--{{ block.settings.line_style }}
                      "
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.line_text }}
                    </span>
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.show_lifestyle and section.settings.lifestyle_text != blank %}
        <div class="kf-brand-story__lifestyle" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}>
          <div class="kf-brand-story__lifestyle-text rte">
            {{ section.settings.lifestyle_text }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.show_closing %}
        <div class="kf-brand-story__closing" {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}>
          <div class="kf-brand-story__closing-copy">
            {% if section.settings.closing_tag != blank %}
              <p class="kf-brand-story__closing-tag">
                {{ section.settings.closing_tag }}
              </p>
            {% endif %}

            {% if section.settings.closing_line_1 != blank or section.settings.closing_accent_1 != blank or section.settings.closing_accent_2 != blank %}
              <h3 class="kf-brand-story__closing-headline">
                {% if section.settings.closing_line_1 != blank %}
                  <span>{{ section.settings.closing_line_1 }}</span>
                {% endif %}

                {% if section.settings.closing_accent_1 != blank %}
                  <span><em>{{ section.settings.closing_accent_1 }}</em></span>
                {% endif %}

                {% if section.settings.closing_accent_2 != blank %}
                  <span class="kf-brand-story__closing-accent-2"><em>{{ section.settings.closing_accent_2 }}</em></span>
                {% endif %}
              </h3>
            {% endif %}

            {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
              <a class="kf-brand-story__cta" href="{{ section.settings.cta_link }}">
                {{ section.settings.cta_label }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.show_closing_mark and section.settings.closing_mark != blank %}
            <div
              class="
                kf-brand-story__closing-mark
                {% if section.settings.hide_closing_mark_mobile %}kf-brand-story__closing-mark--hide-mobile{% endif %}
              "
              aria-hidden="true"
            >
              {{ section.settings.closing_mark }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.right_logo != blank %}
      <div
        class="kf-brand-story__side-logo {% if section.settings.hide_right_logo_mobile %}kf-brand-story__side-logo--hide-mobile{% endif %}"
        {% if section.settings.enable_reveal %}data-kf-reveal{% endif %}
        aria-hidden="true"
      >
        {{
          section.settings.right_logo
          | image_url: width: 900
          | image_tag:
            class: 'kf-brand-story__side-logo-image',
            loading: 'lazy',
            widths: '160, 240, 320, 480, 640, 900',
            sizes: '(min-width: 990px) 24vw, 220px'
        }}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }},
  #{{ section_id }}.kf-brand-story {
    background-color: #fff !important;
    background-image: none !important;
  }

  .kf-brand-story__anchor {
    display: block;
    height: 0;
    scroll-margin-top: calc(var(--header-group-height, var(--header-height, 80px)) + 16px);
  }

  #{{ section_id }} {
    --kf-brand-story-accent: {{ section.settings.accent_color }};
    --kf-brand-story-border: {{ section.settings.border_color }};
    --kf-brand-story-max-width: {{ section.settings.max_width }}px;
    --kf-brand-story-main-column-width: {{ section.settings.main_column_width }}px;
    --kf-brand-story-grid-gap: {{ section.settings.desktop_column_gap }}px;
    --kf-brand-story-right-logo-width: {{ section.settings.right_logo_width }}px;
    --kf-brand-story-right-logo-opacity: {{ section.settings.right_logo_opacity | divided_by: 100.0 }};


    --kf-brand-story-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --kf-brand-story-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --kf-brand-story-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --kf-brand-story-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

    --kf-brand-story-gap-intro-manifesto-desktop: {{ section.settings.gap_intro_manifesto_desktop }}px;
    --kf-brand-story-gap-manifesto-lifestyle-desktop: {{ section.settings.gap_manifesto_lifestyle_desktop }}px;
    --kf-brand-story-gap-lifestyle-closing-desktop: {{ section.settings.gap_lifestyle_closing_desktop }}px;

    --kf-brand-story-gap-intro-manifesto-mobile: {{ section.settings.gap_intro_manifesto_mobile }}px;
    --kf-brand-story-gap-manifesto-lifestyle-mobile: {{ section.settings.gap_manifesto_lifestyle_mobile }}px;
    --kf-brand-story-gap-lifestyle-closing-mobile: {{ section.settings.gap_lifestyle_closing_mobile }}px;

    --kf-brand-story-eyebrow-desktop: {{ section.settings.eyebrow_size_desktop | times: 0.8 }}px;
    --kf-brand-story-eyebrow-mobile: {{ section.settings.eyebrow_size_mobile | times: 0.8 }}px;
    --kf-brand-story-headline-desktop: {{ section.settings.headline_size_desktop | times: 0.8 }}px;
    --kf-brand-story-headline-mobile: {{ section.settings.headline_size_mobile | times: 0.8 }}px;
    --kf-brand-story-body-desktop: {{ section.settings.body_size_desktop | times: 0.8 }}px;
    --kf-brand-story-body-mobile: {{ section.settings.body_size_mobile | times: 0.8 }}px;
    --kf-brand-story-manifesto-desktop: {{ section.settings.manifesto_size_desktop | times: 0.8 }}px;
    --kf-brand-story-manifesto-mobile: {{ section.settings.manifesto_size_mobile | times: 0.8 }}px;
    --kf-brand-story-lifestyle-desktop: {{ section.settings.lifestyle_size_desktop | times: 0.8 }}px;
    --kf-brand-story-lifestyle-mobile: {{ section.settings.lifestyle_size_mobile | times: 0.8 }}px;
    --kf-brand-story-closing-desktop: {{ section.settings.closing_size_desktop | times: 0.8 }}px;
    --kf-brand-story-closing-mobile: {{ section.settings.closing_size_mobile | times: 0.8 }}px;
    --kf-brand-story-cta-desktop: {{ section.settings.cta_size_desktop | times: 0.8 }}px;
    --kf-brand-story-cta-mobile: {{ section.settings.cta_size_mobile | times: 0.8 }}px;
    --kf-brand-story-mark-opacity: {{ section.settings.mark_opacity | divided_by: 100.0 }};

    position: relative;
    overflow: hidden;
    background: rgb(var(--color-background, 247, 245, 241));
    color: rgb(var(--color-foreground, 17, 17, 17));
    font-family: 'Inter', sans-serif;
  }

  #{{ section_id }}.kf-brand-story--top-border {
    border-top: 1px solid var(--kf-brand-story-border);
  }

  #{{ section_id }}.kf-brand-story--bottom-border {
    border-bottom: 1px solid var(--kf-brand-story-border);
  }

  #{{ section_id }} .kf-brand-story__inner {
    position: relative;
    margin: 0 auto;
    padding-top: var(--kf-brand-story-desktop-padding-top);
    padding-bottom: var(--kf-brand-story-desktop-padding-bottom);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, var(--kf-brand-story-main-column-width)) minmax(0, 1fr);
    column-gap: var(--kf-brand-story-grid-gap);
    align-items: start;
  }

  #{{ section_id }} .kf-brand-story__inner > :not(.kf-brand-story__side-logo) {
    grid-column: 2;
  }

  @media (min-width: 821px) {
    #{{ section_id }} .kf-brand-story__inner > :not(.kf-brand-story__side-logo) {
      justify-self: center;
      width: 100%;
    }

    #{{ section_id }} .kf-brand-story__manifesto-lines {
      margin-left: auto;
      margin-right: auto;
      width: 100%;
    }
  }

  #{{ section_id }} .kf-brand-story__side-logo {
    grid-column: 3;
    grid-row: 1 / span 6;
    align-self: {{ section.settings.right_logo_vertical_position }};
    justify-self: {{ section.settings.right_logo_horizontal_position }};
    width: min(100%, var(--kf-brand-story-right-logo-width));
    opacity: var(--kf-brand-story-right-logo-opacity);
    pointer-events: none;
    user-select: none;
  }

  #{{ section_id }} .kf-brand-story__side-logo-image {
    display: block;
    width: 100%;
    height: auto;
  }

  #{{ section_id }}.kf-brand-story--layout-page-width .kf-brand-story__inner {
    width: min(100% - 40px, var(--kf-brand-story-max-width));
  }

  #{{ section_id }}.kf-brand-story--layout-full-width .kf-brand-story__inner {
    width: 100%;
    max-width: none;
    padding-left: clamp(20px, 6vw, 96px);
    padding-right: clamp(20px, 6vw, 96px);
  }

  #{{ section_id }} .kf-brand-story__intro + .kf-brand-story__manifesto {
    margin-top: var(--kf-brand-story-gap-intro-manifesto-desktop);
  }

  #{{ section_id }} .kf-brand-story__manifesto + .kf-brand-story__lifestyle {
    margin-top: var(--kf-brand-story-gap-manifesto-lifestyle-desktop);
  }

  #{{ section_id }} .kf-brand-story__lifestyle + .kf-brand-story__closing {
    margin-top: var(--kf-brand-story-gap-lifestyle-closing-desktop);
  }

  #{{ section_id }} .kf-brand-story__intro + .kf-brand-story__lifestyle {
    margin-top: var(--kf-brand-story-gap-intro-manifesto-desktop);
  }

  #{{ section_id }} .kf-brand-story__manifesto + .kf-brand-story__closing {
    margin-top: var(--kf-brand-story-gap-manifesto-lifestyle-desktop);
  }

  #{{ section_id }} .kf-brand-story__intro + .kf-brand-story__closing {
    margin-top: var(--kf-brand-story-gap-intro-manifesto-desktop);
  }

  #{{ section_id }} .kf-brand-story__intro {
    position: relative;
    z-index: 2;
    max-width: 860px;
  }

  #{{ section_id }} .kf-brand-story__section-heading {
    position: relative;
    z-index: 2;
    margin: 0 0 28px;
    font-family: 'Inter', sans-serif;
    font-size: calc(var(--kf-brand-story-body-desktop) + 5px);
    text-align: center;
    line-height: 2.5;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--kf-brand-story-accent);
  }

  #{{ section_id }} .kf-brand-story__eyebrow,
  #{{ section_id }} .kf-brand-story__closing-tag {
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'Inter', sans-serif;
    font-size: var(--kf-brand-story-eyebrow-desktop);
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--kf-brand-story-accent);
  }

  #{{ section_id }} .kf-brand-story__eyebrow {
    justify-content: center;
    text-align: center;
  }

  #{{ section_id }} .kf-brand-story__eyebrow::before,
  #{{ section_id }} .kf-brand-story__closing-tag::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    flex: 0 0 32px;
    background: currentColor;
  }

  #{{ section_id }} .kf-brand-story__headline {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(
      var(--kf-brand-story-headline-mobile),
      7.4vw,
      var(--kf-brand-story-headline-desktop)
    );
    font-weight: 300;
    line-height: 0.9;
    text-align: center;
    letter-spacing: -0.035em;
    color: rgb(var(--color-foreground, 17, 17, 17));
  }

  #{{ section_id }} .kf-brand-story__headline span {
    display: block;
  }

  #{{ section_id }} .kf-brand-story__headline em,
  #{{ section_id }} .kf-brand-story__closing-headline em {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    color: var(--kf-brand-story-accent);
  }

  #{{ section_id }} .kf-brand-story__intro-text {
    max-width: {{ section.settings.intro_text_max_width }}px;
    margin-top: 30px;
    font-family: 'Inter', sans-serif;
    font-size: var(--kf-brand-story-body-desktop);
    line-height: 1.8;
    font-weight: 300;
    letter-spacing: 0.01em;
    color: rgba(var(--color-foreground, 17, 17, 17), 0.74);
  }

  #{{ section_id }} .kf-brand-story__intro-text p,
  #{{ section_id }} .kf-brand-story__lifestyle-text p {
    margin: 0;
  }

  #{{ section_id }} .kf-brand-story__intro-text p + p,
  #{{ section_id }} .kf-brand-story__lifestyle-text p + p {
    margin-top: 12px;
  }

  #{{ section_id }} .kf-brand-story__manifesto {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--kf-brand-story-border);
    border-bottom: 1px solid var(--kf-brand-story-border);
    overflow: hidden;
  }

  #{{ section_id }} .kf-brand-story__manifesto-lines {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.manifesto_max_width }}px;
  }

  #{{ section_id }} .kf-brand-story__manifesto-line {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(
      var(--kf-brand-story-manifesto-mobile),
      3.1vw,
      var(--kf-brand-story-manifesto-desktop)
    );
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -0.015em;
    color: rgba(var(--color-foreground, 17, 17, 17), 0.72);
  }

  #{{ section_id }} .kf-brand-story__manifesto-line--strong {
    color: rgb(var(--color-foreground, 17, 17, 17));
  }

  #{{ section_id }} .kf-brand-story__manifesto-line--accent {
    color: var(--kf-brand-story-accent);
    font-style: italic;
  }

  #{{ section_id }} .kf-brand-story__manifesto-line--muted {
    color: rgba(var(--color-foreground, 17, 17, 17), 0.58);
  }

  #{{ section_id }} .kf-brand-story__manifesto-line--spacer {
    height: 18px;
  }

  #{{ section_id }} .kf-brand-story__lifestyle {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.lifestyle_max_width }}px;
  }

  #{{ section_id }} .kf-brand-story__lifestyle-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(
      var(--kf-brand-story-lifestyle-mobile),
      2.4vw,
      var(--kf-brand-story-lifestyle-desktop)
    );
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: rgba(var(--color-foreground, 17, 17, 17), 0.74);
  }

  #{{ section_id }} .kf-brand-story__lifestyle-text em {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--kf-brand-story-accent);
  }

  #{{ section_id }} .kf-brand-story__closing {
    position: relative;
    z-index: 2;
    min-height: {{ section.settings.closing_min_height }}px;
    display: flex;
    justify-content: center;
    gap: 40px;
    padding-top: clamp(24px, 4vw, 64px);
  }

  #{{ section_id }} .kf-brand-story__closing-copy {
    position: relative;
    z-index: 2;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  #{{ section_id }} .kf-brand-story__closing-tag {
    justify-content: center;
  }

  #{{ section_id }} .kf-brand-story__closing-headline {
