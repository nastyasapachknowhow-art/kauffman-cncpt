{%- doc -%}
  Renders a price filter.

  @param {object} [filter] - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.
  @param {number} [fallback_range_max] - Price range max to use when Shopify does not return a price filter.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign price_label = filter.label | default: 'Price'
  assign price_param_name = filter.param_name | default: 'filter.v.price'
  assign price_min_param_name = filter.min_value.param_name | default: 'filter.v.price.gte'
  assign price_max_param_name = filter.max_value.param_name | default: 'filter.v.price.lte'
  assign price_min_value = filter.min_value.value
  assign price_max_value = filter.max_value.value
  assign price_range_max = filter.range_max | default: fallback_range_max
  assign min_input_max_value = price_max_value | default: price_range_max
  assign max_input_min_value = price_min_value | default: 0
-%}

{% capture accordion_children %}
  <details
    class="facets__panel facets__item"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">Price</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ price_range_max | money_without_currency }}"
        >
          {%- if price_min_value != null or price_max_value != null %}
            {%- if price_min_value != null and price_max_value != null %}
              {{- price_min_value | money | strip_html -}}
              –
              {{- price_max_value | money | strip_html -}}
            {%- elsif price_min_value != null -%}
              {{ price_min_value | money | strip_html }}–{{ price_range_max | money | strip_html }}

            {%- elsif price_max_value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- price_max_value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ price_param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        on:change="/updatePriceFilterAndResults"
      >
        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ price_min_param_name }}"
                id="{{ price_label | escape }}-GTE-{{ id_prefix }}"
                {%- if price_min_value -%}
                  value="{{ price_min_value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ price_label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ price_max_param_name }}"
                id="{{ price_label | escape }}-LTE-{{ id_prefix }}"
                {%- if price_max_value -%}
                  value="{{ price_max_value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ price_range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ price_range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ price_label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = price_range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if price_min_value != null or price_max_value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{{ accordion_children }}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}
