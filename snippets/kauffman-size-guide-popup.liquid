{%- doc -%}
  Renders the product size-guide dialog.

  @param {string} component_id - Unique id for the dialog component.
  @param {string} dialog_id - Unique id for the dialog.
  @param {object} size_guide - Product-specific Size guide metaobject.
  @param {object} size_guide_page - Shopify page containing the size-guide content.
  @param {string} [product_type] - Normalized product type used to filter combined guides.
  @param {string} [heading] - Optional dialog heading override.
{%- enddoc -%}

{% liquid
  assign dialog_heading = heading | default: size_guide_page.title | default: 'Size guide'
  assign heading_id = dialog_id | append: '-Heading'
  assign size_guide_rows = size_guide.rows.value
  assign size_guide_sizes = size_guide.sizes.value
  assign has_product_size_guide = false

  if size_guide != blank and size_guide_rows != blank and size_guide_sizes != blank
    assign has_product_size_guide = true
  endif
%}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<dialog-component id="{{ component_id }}" class="kauffman-size-guide-popup">
  <dialog
    id="{{ dialog_id }}"
    ref="dialog"
    class="kauffman-size-guide-popup__dialog dialog-modal color-{{ settings.popover_color_scheme }}"
    aria-labelledby="{{ heading_id }}"
    scroll-lock
  >
    <div class="kauffman-size-guide-popup__header">
      <h2 id="{{ heading_id }}" class="kauffman-size-guide-popup__title">
        {{- dialog_heading | escape -}}
      </h2>
      <button
        type="button"
        ref="closeButton"
        on:click="/closeDialog"
        class="kauffman-size-guide-popup__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <div class="kauffman-size-guide-popup__body">
      <div
        class="kauffman-size-guide-popup__content rte"
        {% if product_type != blank %}
          data-kauffman-size-guide-product-type="{{ product_type }}"
        {% endif %}
      >
        {%- if has_product_size_guide -%}
          <div class="kauffman-product-size-guide">
            {%- if size_guide.intro_text.value != blank -%}
              <p class="kauffman-product-size-guide__intro">{{ size_guide.intro_text.value | escape | newline_to_br }}</p>
            {%- endif -%}

            <div class="kauffman-product-size-guide__scroll" role="region" aria-label="{{ size_guide.title.value | default: 'Size guide' | escape }} measurements" tabindex="0">
              <table class="kauffman-product-size-guide__table">
                <thead>
                  <tr>
                    <th scope="col">Measurement</th>
                    {%- for size in size_guide_sizes -%}
                      <th scope="col">{{ size | escape }}</th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in size_guide_rows -%}
                    {% liquid
                      assign row_values = row.values.value
                      assign spans_all_sizes = row.span_all_sizes.value
                    %}
                    <tr{% if spans_all_sizes %} class="kauffman-product-size-guide__row--shared"{% endif %}>
                      <th scope="row">
                        {{- row.label.value | escape -}}
                        {%- if row.unit.value != blank -%}
                          <span class="kauffman-product-size-guide__unit">&nbsp;{{ row.unit.value | escape }}</span>
                        {%- endif -%}
                      </th>
                      {%- if spans_all_sizes -%}
                        <td colspan="{{ size_guide_sizes.size }}" class="kauffman-product-size-guide__shared-value">
                          <span class="kauffman-product-size-guide__shared-value-content">
                            <span>{{ row_values.first | escape }}</span>
                            <span class="kauffman-product-size-guide__shared-label">All sizes</span>
                          </span>
                        </td>
                      {%- else -%}
                        {%- for size in size_guide_sizes -%}
                          <td>{{ row_values[forloop.index0] | default: '—' | escape }}</td>
                        {%- endfor -%}
                      {%- endif -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {%- if size_guide.how_to_measure.value != blank -%}
              <div class="kauffman-product-size-guide__measure rte">
                {{ size_guide.how_to_measure | metafield_tag }}
              </div>
            {%- endif -%}
          </div>
        {%- elsif size_guide_page != blank and size_guide_page.content != blank -%}
          {{- size_guide_page.content -}}
        {%- elsif request.design_mode -%}
          <p>Select a page with size-guide content in the Variant picker settings.</p>
        {%- else -%}
          <p>Size guide content is currently unavailable.</p>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</dialog-component>

{% stylesheet %}
  .kauffman-size-guide-popup__dialog {
    width: min(760px, calc(100vw - 48px));
    max-width: 760px;
    max-height: min(82dvh, 900px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 2px;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.2);
  }

  .kauffman-size-guide-popup__dialog[open] {
    display: flex;
    flex-direction: column;
    animation: kauffman-size-guide-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .kauffman-size-guide-popup__dialog.dialog-closing {
    animation: kauffman-size-guide-out 160ms ease both;
  }

  .kauffman-size-guide-popup__dialog::backdrop {
    background: rgb(0 0 0 / 0.48);
    backdrop-filter: blur(2px);
  }

  .kauffman-size-guide-popup__header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    padding: 22px 28px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .kauffman-size-guide-popup__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .kauffman-size-guide-popup__close {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .kauffman-size-guide-popup__close:hover {
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .kauffman-size-guide-popup__close:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .kauffman-size-guide-popup__close svg {
    width: 14px;
    height: 14px;
  }

  .kauffman-size-guide-popup__body {
    min-height: 0;
    padding: 28px;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .kauffman-size-guide-popup__content {
    color: inherit;
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }

  .kauffman-size-guide-popup__content > :first-child {
    margin-top: 0;
  }

  .kauffman-size-guide-popup__content > :last-child {
    margin-bottom: 0;
  }

  .kauffman-size-guide-popup__content table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
  }

  .kauffman-size-guide-popup__content :is(th, td) {
    padding: 13px 16px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    text-align: center;
  }

  .kauffman-size-guide-popup__content th {
    background: transparent;
    font-weight: 500;
  }

  .kauffman-size-guide-popup__content :is(thead, tr:not(:has(td))) {
    background: transparent;
  }

  /*
   * The default Size guide page contains both apparel tables. Keep its markup
   * reusable while showing only the table that matches the product page.
   */
  .kauffman-size-guide-popup__content[data-kauffman-size-guide-product-type='t-shirt']
    .kf-size-guide__section[aria-labelledby='kf-hoodies-heading'],
  .kauffman-size-guide-popup__content[data-kauffman-size-guide-product-type='hoodie']
    .kf-size-guide__section[aria-labelledby='kf-tshirts-heading'] {
    display: none;
  }

  .kauffman-size-guide-popup__content[data-kauffman-size-guide-product-type='hoodie']
    .kf-size-guide__section[aria-labelledby='kf-hoodies-heading'] {
    margin-top: 0;
  }

  .kauffman-product-size-guide {
    --kauffman-size-guide-border: rgb(var(--color-foreground-rgb) / 0.16);
  }

  .kauffman-product-size-guide__intro {
    max-width: 620px;
    margin: 0 0 28px;
  }

  .kauffman-product-size-guide__scroll {
    width: 100%;
    overflow-x: auto;
    border-top: 1px solid var(--kauffman-size-guide-border);
    -webkit-overflow-scrolling: touch;
  }

  .kauffman-size-guide-popup__content .kauffman-product-size-guide__table {
    width: 100%;
    min-width: 560px;
    max-width: 100%;
    border: 0;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 12px;
    line-height: 1.35;
  }

  .kauffman-product-size-guide__table :is(th, td) {
    height: 52px;
    padding: 12px 14px;
    border: 0;
    border-bottom: 1px solid var(--kauffman-size-guide-border);
    background: transparent;
    text-align: center;
    vertical-align: middle;
  }

  .kauffman-product-size-guide__table thead th {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kauffman-product-size-guide__table :is(th, td):first-child {
    width: 150px;
    padding-left: 0;
    font-weight: 600;
    text-align: left;
  }

  .kauffman-product-size-guide__unit {
    font-size: 0.68em;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .kauffman-product-size-guide__row--shared :is(th, td) {
    background: rgb(var(--color-foreground-rgb) / 0.025);
  }

  .kauffman-product-size-guide__shared-value-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 500;
  }

  .kauffman-product-size-guide__shared-label {
    color: rgb(var(--color-foreground-rgb) / 0.56);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .kauffman-product-size-guide__measure {
    margin-top: 28px;
  }

  @keyframes kauffman-size-guide-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes kauffman-size-guide-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  @media screen and (max-width: 820px) {
    .kauffman-size-guide-popup__dialog {
      width: 100%;
      max-width: none;
      max-height: 88dvh;
      margin: auto 0 0;
      border-width: 1px 0 0;
      border-radius: 18px 18px 0 0;
    }

    .kauffman-size-guide-popup__dialog[open] {
      animation-name: kauffman-size-guide-sheet-in;
    }

    .kauffman-size-guide-popup__dialog.dialog-closing {
      animation-name: kauffman-size-guide-sheet-out;
    }

    .kauffman-size-guide-popup__header {
      min-height: 68px;
      padding: 16px 18px;
    }

    .kauffman-size-guide-popup__title {
      font-size: 27px;
    }

    .kauffman-size-guide-popup__close {
      width: 38px;
      height: 38px;
      flex-basis: 38px;
    }

    .kauffman-size-guide-popup__body {
      padding: 20px 18px 28px;
    }

    .kauffman-size-guide-popup__content {
      font-size: 13px;
    }

    .kauffman-size-guide-popup__content .kauffman-product-size-guide__table {
      min-width: 0;
      width: 100%;
      font-size: 11px;
    }

    .kauffman-product-size-guide__table :is(th, td) {
      height: 48px;
      padding: 10px 8px;
    }

    .kauffman-product-size-guide__table :is(th, td):first-child {
      width: 43%;
      padding-right: 10px;
    }

    .kauffman-product-size-guide__table thead :is(th, td) {
      height: 34px;
      padding-block: 5px;
    }

    .kauffman-product-size-guide__table thead th {
      font-size: 9px;
    }

    .kauffman-product-size-guide__shared-value-content {
      gap: 6px;
    }

    .kauffman-product-size-guide__shared-label {
      font-size: 8px;
      letter-spacing: 0.06em;
    }
  }

  @keyframes kauffman-size-guide-sheet-in {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes kauffman-size-guide-sheet-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kauffman-size-guide-popup__dialog[open],
    .kauffman-size-guide-popup__dialog.dialog-closing {
      animation-duration: 1ms;
    }
  }
{% endstylesheet %}
