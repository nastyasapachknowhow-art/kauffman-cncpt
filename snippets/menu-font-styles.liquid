{%- doc -%}
  Derives CSS variables from the menu typography settings for 1st level/main menu items.

  @param {object} settings - The block settings object containing typography settings.
  @param {string} menu_type - The menu type: 'drawer' or 'mega_menu'.
{%- enddoc -%}

--menu-top-level-font-family: Inter, var(--font-{{ settings.type_font_primary_link }}--family), sans-serif;
--menu-top-level-font-size-desktop: 13px; --menu-top-level-font-style: var(--font-
{{- settings.type_font_primary_link -}}
--style); --menu-top-level-font-weight: var(--font-
{{- settings.type_font_primary_link -}}
--weight); --menu-top-level-font-case:
{%- if settings.type_case_primary_link == 'uppercase' %}uppercase{% else %}none{% endif -%}
;
{% if menu_type == 'drawer' %}
  --menu-top-level-font-size: 13px;
  --menu-top-level-font-line-height: 18px;
{% else %}
  --menu-top-level-font-size: 13px;
  --menu-top-level-font-line-height: 18px;
{% endif %}
--menu-top-level-font-letter-spacing: 0.08em;
--menu-top-level-font-color: var(--color-foreground); --menu-top-level-font-color-rgb: var(--color-foreground-rgb);
